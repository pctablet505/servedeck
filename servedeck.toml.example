# Servedeck configuration. Copy to `servedeck.toml` and edit.
# Every value is optional — Servedeck detects what it can.

# Where run state is kept (desired state, boot history, measurements).
# state_dir = "./state"

# Hugging Face model cache. Detected from HF_HUB_CACHE / HF_HOME if unset.
# model_cache = "~/.cache/huggingface/hub"

# Total VRAM in MiB. Detected via nvidia-smi if unset.
# gpu_total_mib = 24564

# VRAM that is neither weights nor KV cache (activations, CUDA graphs).
# Raise it if your predictions come out optimistic.
# overhead_gib = 4.7

# If any of these files exists, Servedeck refuses to start a server —
# something else (a training run) wants the GPU.
# training_markers = ["~/run/training_in_progress"]

# listen_host = "127.0.0.1"
# listen_port = 8010

# --- Backends -----------------------------------------------------------
# A backend is a script you already use to start a model server. Servedeck
# runs it and passes settings through the environment, so your launcher keeps
# owning the flags.

[backends.vllm]
launcher = "~/serve.sh"
port = 8000
# The venv the server runs out of. Checked before every start (a stale venv
# path is the single largest boot-failure class), and used to recognise a
# server you started by hand so Servedeck can adopt and supervise it.
venv = "~/.venv-vllm"

# Where a HAND-started run of this backend writes its log. Servedeck reads it
# to recover an adopted server's boot numbers. Leave it out if your launcher
# has no fixed log — Servedeck then uses the one it opened itself, under
# state/boot_logs/<backend>-*.log. Never name another backend's log here: the
# phase machine would file its errors as this backend's failures.
log_path = "~/serve.log"
# Set this only if the launcher redirects its OWN output into log_path
# (`exec >> "$LOG"`). Servedeck then tails that file during a launch too,
# because the boot output stops arriving on the pipe it opened.
# writes_own_log = true

# Which architectures (config.json -> architectures[0]) this backend can load.
# Models with an architecture no backend claims are listed but not startable.
# This is also how you teach Servedeck a model family it does not know.
architectures = ["Qwen3ForCausalLM", "LlamaForCausalLM", "MistralForCausalLM"]

# Set if starting this backend needs a terminal (e.g. an interactive sudo
# prompt). Servedeck will not try to restart it unattended; it reports
# blocked-needs-human instead of looping forever.
# needs_tty = true

# Where to run the launcher from. Defaults to the directory the launcher is in
# — the same rule a shell CLI's `cd "$(dirname "$SERVE_SH")"` uses, and right
# for a serve script sitting at a project root. It is not right for a launcher
# under bin/: that directory is not the tree the server belongs to, so any
# relative path the launcher uses resolves one level down. Set this when your
# launcher cares; a launcher that derives its own root from $BASH_SOURCE does
# not.
# cwd = "~/Projects/local_llm"

# Cold-boot ETA envelope [low, high] in seconds, used only until this model
# has produced boot history of its own. How long a checkpoint takes to load is
# a fact about one machine — 181 GiB of weights plus a Marlin repack behaves
# nothing like a 40 GiB model — so there is no useful default.
# cold_boot_range_s = [420.0, 900.0]

# Environment variables your launcher reads. Left side is Servedeck's setting
# name, right side is your variable. An EMPTY table means "this launcher reads
# no environment" (it takes its settings from a file); omitting the table
# entirely gets the defaults below.
[backends.vllm.env_map]
repo_id = "MODEL"
port = "PORT"
max_model_len = "MAX_LEN"
util = "GPU_UTIL"
max_num_seqs = "MAX_SEQS"
served_name = "SERVED_NAME"
kv_dtype = "KV_DTYPE"

# Fixed environment for this backend, passed to the launcher verbatim on every
# start. This is where machine-specific tuning goes — offload sizing, a KV cap,
# a feature flag your build understands. Servedeck never interprets these; the
# launcher owns their meaning.
# [backends.vllm.env]
# CPU_OFFLOAD_GB = "104"

# --- EXTRA_ARGS ---------------------------------------------------------
# Servedeck exports EXTRA_ARGS to every launcher, whether or not env_map names
# it: it is the conventional verbatim passthrough slot, and a launcher that
# does not read it ignores it. The value comes from `shell_config_script`'s
# config file, and ONLY when that file's BACKEND matches the backend being
# started — that file describes one backend at a time, and handing one
# launcher another's flags is worse than handing it none.
#
# To pin extra arguments per backend regardless of the shell config, set them
# in that backend's [env] table instead; it is applied last and wins.
