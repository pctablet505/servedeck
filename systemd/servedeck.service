[Unit]
# servedeck v2 — the registry, the supervisor, the /v1 gateway and the page.
# A systemd --user unit: no sudo anywhere in this project.
#
# Install:
#   cp systemd/servedeck.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now servedeck
#
# Models are NOT started from here. servedeck launches each one as its own
# transient unit (systemd-run --user --unit=model-<key> --collect), so nothing
# below can reach a model.
Description=servedeck — local model registry, supervisor and gateway
Documentation=https://github.com/pctablet505/servedeck
After=graphical-session.target

# --- Observed failure R4 (REDESIGN-2026-09-12.md §4): a crash loop with a
# real vLLM boot on every lap. On 2026-09-11 this unit could not bind :8010
# (a hand-started copy held it), had no StartLimit* at all, and looped 67
# times in 9 minutes. Three attempts in a minute and then a loud, visible
# `failed` is the correct behaviour for an install that is actually broken:
# a fourth attempt has never once been the thing that fixed it.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec

# --- The checkout is the deployment: models.toml, state/ and the venv are all
# resolved relative to it. %h is the user's home; edit both this and ExecStart
# if you cloned elsewhere. Declared exactly once — systemd keeps the LAST
# value of a non-repeatable directive and says nothing, so a second copy of
# this line further down would be the one that applies while the one an
# operator can see above it would not.
WorkingDirectory=%h/Projects/servedeck
ExecStart=%h/Projects/servedeck/.venv/bin/python -m servedeck

# --- Observed failure R4: KillMode's default is control-group, which SIGKILLs
# everything in the unit's cgroup on stop. With v1's in-process launcher that
# took the model down with the dashboard on every restart (journal 2026-09-11
# 21:38:12). v2's models live in their own cgroups so this is now belt and
# braces, but `process` states the intent: this stop signals uvicorn, and
# nothing else.
KillMode=process
KillSignal=SIGTERM

# --- Observed failure: every single stop took the full timeout and ended in a
# SIGKILL, because each open page held an SSE generator parked on a queue that
# nothing would ever fill again and uvicorn waited for them. Hub.close() hands
# every subscriber a sentinel now, so a clean shutdown is well under a second
# and this is only a backstop — 15s, not the 90s default, because a servedeck
# that has not exited in 15s is not going to.
TimeoutStopSec=15
TimeoutStartSec=30

# --- Observed failure R4, the other half: `Restart=always` plus a failing
# bind is what turns one lost race for :8010 into an unbounded loop. A clean
# exit is an operator stopping the process and must stay stopped; only a
# failure is worth retrying, and only StartLimitBurst-many times.
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=servedeck

[Install]
WantedBy=default.target
