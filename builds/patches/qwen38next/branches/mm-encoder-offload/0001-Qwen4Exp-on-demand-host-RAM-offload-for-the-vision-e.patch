@@ -0,0 +1,171 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Qwen4Exp's own use of the multimodal encoder offloader.
+
+The offloader itself is covered by
+tests/model_executor/offloader/test_mm_encoder_offload.py. What is tested here
+is the model's wiring: that `load_weights` hands the vision tower over, with
+the prefixes that leave `patch_embed`/`pos_embed` alone, and that a plain
+text-only deployment is untouched.
+"""
+
+import pytest
+import torch
+import torch.nn as nn
+
+from vllm.models.qwen4_exp.nvidia.model import Qwen4ExpForConditionalGeneration
+
+_offload = Qwen4ExpForConditionalGeneration._maybe_offload_mm_encoder
+
+HIDDEN, INTERMEDIATE, OUT_HIDDEN, MERGE = 1152, 4304, 2560, 2
+
+
+@pytest.fixture(autouse=True)
+def _no_pinned_memory(monkeypatch: pytest.MonkeyPatch):
+    """On the box the host copies are pinned; a CPU-only runner has no CUDA
+    allocator to pin with, and pinning is not what these tests are about."""
+    monkeypatch.setattr(
+        "vllm.model_executor.offloader.mm_encoder.should_pin_memory", lambda: False
+    )
+
+
+def _tiny_tower(depth: int = 1) -> nn.Module:
+    """One real-width block plus a merger: big enough to clear the offloader's
+    1 MiB floor, small enough to build in a CPU test."""
+    merged = HIDDEN * MERGE**2
+    tower = nn.Module()
+    tower.patch_embed = nn.Module()
+    tower.patch_embed.proj = nn.Conv3d(3, HIDDEN, (2, 16, 16), stride=(2, 16, 16))
+    tower.pos_embed = nn.Embedding(2304, HIDDEN)
+
+    blocks = nn.ModuleList()
+    for _ in range(depth):
+        block = nn.Module()
+        block.norm1 = nn.LayerNorm(HIDDEN)
+        block.norm2 = nn.LayerNorm(HIDDEN)
+        block.attn = nn.Module()
+        block.attn.qkv = nn.Linear(HIDDEN, 3 * HIDDEN)
+        block.attn.proj = nn.Linear(HIDDEN, HIDDEN)
+        block.mlp = nn.Module()
+        block.mlp.linear_fc1 = nn.Linear(HIDDEN, INTERMEDIATE)
+        block.mlp.linear_fc2 = nn.Linear(INTERMEDIATE, HIDDEN)
+        blocks.append(block)
+    tower.blocks = blocks
+
+    tower.merger = nn.Module()
+    tower.merger.norm = nn.LayerNorm(HIDDEN)
+    tower.merger.linear_fc1 = nn.Linear(merged, merged)
+    tower.merger.linear_fc2 = nn.Linear(merged, OUT_HIDDEN)
+    return tower
+
+
+class _Stub:
+    """The two attributes `__init__` sets, plus the real methods.
+
+    Borrowing the unbound methods rather than instantiating the model keeps
+    this a CPU test: constructing Qwen4ExpForConditionalGeneration would build
+    a 48-layer MoE decoder.
+    """
+
+    process_weights_after_loading = (
+        Qwen4ExpForConditionalGeneration.process_weights_after_loading
+    )
+    _maybe_offload_mm_encoder = _offload
+
+    def __init__(self, mode: str, tower: nn.Module) -> None:
+        self.visual = tower
+        self.mm_encoder_offload_mode = mode
+        self.mm_encoder_offloader = None
+
+
+def _stub(mode: str, tower: nn.Module) -> _Stub:
+    return _Stub(mode, tower)
+
+
+def test_offloads_the_projections_and_leaves_the_kernel_fed_weights_alone():
+    tower = _tiny_tower()
+    model = _stub("onload", tower)
+
+    _offload(model)
+
+    offloader = model.mm_encoder_offloader
+    assert set(offloader.offloaded_modules) == {
+        "blocks.0.attn.qkv",
+        "blocks.0.attn.proj",
+        "blocks.0.mlp.linear_fc1",
+        "blocks.0.mlp.linear_fc2",
+        "merger.linear_fc1",
+        "merger.linear_fc2",
+    }
+    # pos_embed.weight is read by a Triton kernel outside any module call, and
+    # patch_embed backs the tower's .dtype/.device properties.
+    assert "pos_embed" not in offloader.offloaded_modules
+    assert "patch_embed.proj" not in offloader.offloaded_modules
+
+
+def test_offloading_preserves_the_tower_dtype_and_device_properties():
+    """`_process_image_input` casts pixels with `self.visual.dtype`, which
+    reads patch_embed's weight - so patch_embed must survive on the device."""
+    tower = _tiny_tower()
+    before = (tower.patch_embed.proj.weight.dtype, tower.patch_embed.proj.weight.device)
+
+    _offload(_stub("onload", tower))
+
+    assert (
+        tower.patch_embed.proj.weight.dtype,
+        tower.patch_embed.proj.weight.device,
+    ) == before
+
+
+def test_mode_none_leaves_the_model_untouched():
+    tower = _tiny_tower()
+    model = _stub("none", tower)
+
+    _offload(model)
+
+    assert model.mm_encoder_offloader is None
+    assert tower.blocks[0].attn.qkv.weight.device == torch.device("cpu")
+
+
+def test_a_tower_with_no_parameters_is_skipped():
+    """`--limit-mm-per-prompt '{"image":0,"video":0}'` replaces the tower with a
+    StageMissingLayer even when --language-model-only is absent, so the offload
+    path can be reached with nothing to offload. It must not abort the load."""
+    from vllm.model_executor.models.utils import StageMissingLayer
+
+    model = _stub("onload", StageMissingLayer("vision_tower"))
+
+    _offload(model)
+
+    assert model.mm_encoder_offloader is None
+
+
+def test_the_post_load_hook_is_what_triggers_the_offload():
+    """`load_weights` is too early: every layer's
+    `quant_method.process_weights_after_loading` runs after it, and
+    `device_loading_context` would pull a host-resident parameter back onto the
+    device and hand it back as a fresh, unpinned CPU tensor. The model-level
+    post-load hook is the last pass over the weights, so that is where the
+    offload has to happen."""
+    tower = _tiny_tower()
+    model = _stub("onload", tower)
+
+    model.process_weights_after_loading()
+
+    assert model.mm_encoder_offloader is not None
+    assert model.mm_encoder_offloader.offloaded_bytes > 0
+
+
+def test_offloading_twice_does_not_pin_a_second_copy():
+    """A sleep/wake_up reload runs the post-load hooks again."""
+    tower = _tiny_tower()
+    model = _stub("onload", tower)
+
+    _offload(model)
+    first = model.mm_encoder_offloader
+    _offload(model)
+
+    assert model.mm_encoder_offloader is first
+    assert first.onload_calls == 0
+    # Two stacked hook pairs would fire twice for one forward.
+    assert len(first._handles) == 2 * len(first.offloaded_modules)
