@@ -0,0 +1,404 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for on-demand host-RAM offloading of the multimodal encoder.
+
+These run entirely on CPU: the "device" the offloader onloads to is meta or CPU
+and the modules are tiny stand-ins shaped like a ViT block, so the
+module-selection rules and the onload/free lifecycle are exercised without a
+GPU.
+"""
+
+import pytest
+import torch
+import torch.nn as nn
+
+from vllm.model_executor.offloader.mm_encoder import (
+    VISION_TOWER_PROJECTION_PREFIXES,
+    MMEncoderOffloader,
+    module_param_bytes,
+    resolve_mm_encoder_offload_mode,
+    select_offload_modules,
+)
+
+
+class _Block(nn.Module):
+    """A ViT block in miniature: big projections, tiny norms."""
+
+    def __init__(self, dim: int, big: int) -> None:
+        super().__init__()
+        self.norm1 = nn.LayerNorm(dim)
+        self.qkv = nn.Linear(dim, big, bias=True)
+        self.proj = nn.Linear(big, dim, bias=True)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.proj(self.qkv(self.norm1(x)))
+
+
+class _Tower(nn.Module):
+    def __init__(self, dim: int = 64, big: int = 4096, depth: int = 2) -> None:
+        super().__init__()
+        # Stands in for patch_embed/pos_embed: parameters that some kernel
+        # reads directly, so they must never be selected.
+        self.pos_embed = nn.Embedding(4096, dim)
+        self.blocks = nn.ModuleList(_Block(dim, big) for _ in range(depth))
+        self.merger = nn.Linear(dim, big, bias=False)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        for block in self.blocks:
+            x = block(x)
+        return self.merger(x)
+
+
+TOWER_PREFIXES = ("blocks.", "merger.")
+
+
+class _FakeDeviceOffloader(MMEncoderOffloader):
+    """Stands in for an accelerator on a CPU-only test runner.
+
+    A real H2D copy lands in a different storage; ``Tensor.to("cpu")`` from CPU
+    returns the very same tensor, so without this the residency assertions
+    below would pass no matter what the hooks did.
+    """
+
+    def _to_device(self, tensor: torch.Tensor) -> torch.Tensor:
+        return tensor.clone()
+
+
+def _is_resident(module: nn.Module, host_ptrs: set[int]) -> bool:
+    """True when this module's parameters are the device copies, not the
+    host originals."""
+    return any(
+        param.data_ptr() not in host_ptrs
+        for _, param in module.named_parameters(recurse=False)
+    )
+
+
+def _host_ptrs(offloader: MMEncoderOffloader) -> set[int]:
+    return {
+        tensor.data_ptr()
+        for params in offloader._host_params.values()
+        for tensor in params.values()
+    }
+
+
+def _names(selected):
+    return [name for name, _ in selected]
+
+
+# --------------------------------------------------------------------------
+# module selection
+# --------------------------------------------------------------------------
+
+
+def test_selects_only_big_leaf_modules_under_the_allowlist():
+    tower = _Tower()
+    selected = select_offload_modules(
+        tower, include_prefixes=TOWER_PREFIXES, min_bytes=1 << 16
+    )
+
+    assert _names(selected) == [
+        "blocks.0.qkv",
+        "blocks.0.proj",
+        "blocks.1.qkv",
+        "blocks.1.proj",
+        "merger",
+    ]
+
+
+def test_excluded_prefixes_are_never_selected():
+    """pos_embed's weight is passed to a kernel directly, so it must stay put."""
+    tower = _Tower()
+    selected = select_offload_modules(tower, min_bytes=1 << 16)
+    assert "pos_embed" in _names(selected), "guard: pos_embed is big enough to qualify"
+
+    selected = select_offload_modules(
+        tower, exclude_prefixes=("pos_embed",), min_bytes=1 << 16
+    )
+    assert "pos_embed" not in _names(selected)
+
+
+def test_containers_are_never_selected():
+    """A container's bytes belong to its children; selecting it double-counts
+    them and would fire the hooks twice per forward."""
+    tower = _Tower()
+    selected = select_offload_modules(
+        tower, include_prefixes=TOWER_PREFIXES, min_bytes=1 << 16
+    )
+    names = _names(selected)
+    assert "blocks" not in names
+    assert "blocks.0" not in names
+    for _, module in selected:
+        assert module_param_bytes(module) > 0
+
+
+def test_min_bytes_keeps_tiny_modules_resident():
+    tower = _Tower()
+    selected = select_offload_modules(
+        tower, include_prefixes=TOWER_PREFIXES, min_bytes=1 << 16
+    )
+    assert not any(name.endswith("norm1") for name in _names(selected))
+
+    # With no threshold the norms qualify too - proof the exclusion above is
+    # the threshold's doing and not an accident of the allowlist.
+    selected = select_offload_modules(
+        tower, include_prefixes=TOWER_PREFIXES, min_bytes=0
+    )
+    assert "blocks.0.norm1" in _names(selected)
+
+
+# --------------------------------------------------------------------------
+# onload / free lifecycle
+# --------------------------------------------------------------------------
+
+
+def test_offload_moves_weights_off_the_device_and_reports_the_bytes():
+    tower = _Tower()
+    expected = sum(
+        module_param_bytes(m)
+        for _, m in select_offload_modules(
+            tower, include_prefixes=TOWER_PREFIXES, min_bytes=1 << 16
+        )
+    )
+
+    offloader = MMEncoderOffloader("onload", "cpu", min_bytes=1 << 16,
+                                   pin_memory=False)
+    moved = offloader.offload(tower, include_prefixes=TOWER_PREFIXES)
+
+    assert moved == expected
+    assert offloader.offloaded_bytes == expected
+    assert len(offloader.offloaded_modules) == 5
+
+
+def test_weights_are_onloaded_for_the_forward_and_freed_after():
+    """The whole point: device residency is confined to the forward pass."""
+    tower = _Tower()
+    offloader = _FakeDeviceOffloader("onload", "cpu", min_bytes=1 << 16,
+                                     pin_memory=False)
+    offloader.offload(tower, include_prefixes=TOWER_PREFIXES)
+    host_ptrs = _host_ptrs(offloader)
+
+    seen: list[bool] = []
+    tower.blocks[0].qkv.register_forward_pre_hook(
+        lambda module, args: seen.append(_is_resident(module, host_ptrs))
+    )
+
+    assert not _is_resident(tower.blocks[0].qkv, host_ptrs)
+    tower(torch.zeros(2, 64))
+
+    # The recording hook runs after the onload hook registered before it.
+    assert seen == [True]
+    # ... and every offloaded module is back on the host afterwards.
+    for name in offloader.offloaded_modules:
+        assert not _is_resident(tower.get_submodule(name), host_ptrs), name
+
+    assert offloader.onload_calls == 5
+    assert offloader.free_calls == 5
+
+
+def test_only_the_running_module_is_resident():
+    """Peak device residency is one module, not the whole tower - this is what
+    makes the design fit a server with no spare VRAM."""
+    tower = _Tower()
+    offloader = _FakeDeviceOffloader("onload", "cpu", min_bytes=1 << 16,
+                                     pin_memory=False)
+    offloader.offload(tower, include_prefixes=TOWER_PREFIXES)
+    host_ptrs = _host_ptrs(offloader)
+
+    peak = 0
+
+    def _measure(module, args):
+        nonlocal peak
+        resident = sum(
+            module_param_bytes(tower.get_submodule(n))
+            for n in offloader.offloaded_modules
+            if _is_resident(tower.get_submodule(n), host_ptrs)
+        )
+        peak = max(peak, resident)
+
+    for name in offloader.offloaded_modules:
+        tower.get_submodule(name).register_forward_pre_hook(_measure)
+
+    tower(torch.zeros(2, 64))
+
+    largest = max(
+        module_param_bytes(tower.get_submodule(n)) for n in offloader.offloaded_modules
+    )
+    assert peak == largest
+    assert peak < offloader.offloaded_bytes
+
+
+def test_forward_result_is_unchanged_by_offloading():
+    torch.manual_seed(0)
+    tower = _Tower(dim=16, big=256, depth=2)
+    x = torch.randn(3, 16)
+    with torch.no_grad():
+        expected = tower(x)
+
+    offloader = _FakeDeviceOffloader("onload", "cpu", min_bytes=0,
+                                     pin_memory=False)
+    offloader.offload(tower, include_prefixes=TOWER_PREFIXES)
+    assert offloader.offloaded_modules, "guard: nothing was offloaded"
+    with torch.no_grad():
+        got = tower(x)
+
+    torch.testing.assert_close(got, expected)
+
+
+def test_close_removes_the_hooks():
+    tower = _Tower()
+    offloader = MMEncoderOffloader("onload", "cpu", pin_memory=False)
+    offloader.offload(tower, include_prefixes=TOWER_PREFIXES)
+    offloader.close()
+
+    tower(torch.zeros(2, 64))
+    assert offloader.onload_calls == 0
+
+
+def test_mode_none_is_a_no_op():
+    tower = _Tower()
+    offloader = MMEncoderOffloader("none", "cpu", pin_memory=False)
+    assert offloader.offload(tower, include_prefixes=TOWER_PREFIXES) == 0
+    assert tower.blocks[0].qkv.weight.device.type == "cpu"
+    assert offloader.offloaded_modules == []
+
+
+def test_unknown_mode_is_rejected():
+    with pytest.raises(ValueError, match="Unknown mm encoder offload mode"):
+        MMEncoderOffloader("swap", "cpu")
+
+
+# --------------------------------------------------------------------------
+# config resolution
+# --------------------------------------------------------------------------
+
+
+class _FakeCompilationConfig:
+    def __init__(self, compile_mm_encoder=False, cudagraph_mm_encoder=False):
+        self.compile_mm_encoder = compile_mm_encoder
+        self.cudagraph_mm_encoder = cudagraph_mm_encoder
+
+
+class _FakeOffloadConfig:
+    def __init__(self, mm_encoder_offload):
+        self.mm_encoder_offload = mm_encoder_offload
+
+
+class _FakeVllmConfig:
+    def __init__(self, mode, **compile_kwargs):
+        self.offload_config = _FakeOffloadConfig(mode)
+        self.compilation_config = _FakeCompilationConfig(**compile_kwargs)
+
+
+@pytest.mark.parametrize("mode", ["none", "onload", "uva"])
+def test_resolve_passes_the_configured_mode_through(mode):
+    assert resolve_mm_encoder_offload_mode(_FakeVllmConfig(mode)) == mode
+
+
+@pytest.mark.parametrize(
+    "flag", ["compile_mm_encoder", "cudagraph_mm_encoder"]
+)
+def test_onload_is_rejected_when_the_encoder_graph_is_captured(flag):
+    """A captured graph bakes in weight pointers that onload invalidates."""
+    config = _FakeVllmConfig("onload", **{flag: True})
+    with pytest.raises(ValueError, match="uva"):
+        resolve_mm_encoder_offload_mode(config)
+
+
+@pytest.mark.parametrize(
+    "flag", ["compile_mm_encoder", "cudagraph_mm_encoder"]
+)
+def test_uva_is_allowed_when_the_encoder_graph_is_captured(flag):
+    config = _FakeVllmConfig("uva", **{flag: True})
+    assert resolve_mm_encoder_offload_mode(config) == "uva"
+
+
+# --------------------------------------------------------------------------
+# the selection the Qwen4Exp model actually asks for
+# --------------------------------------------------------------------------
+
+# Qwen3.8-Flash-Next vision_config: depth 27, hidden 1152, intermediate 4304,
+# out_hidden_size 2560, spatial_merge_size 2, all weights bfloat16.
+QWEN_TOWER_INCLUDE_PREFIXES = VISION_TOWER_PROJECTION_PREFIXES
+# Sum of the selected tensors in model-bf16-00001.safetensors of
+# mazinb/Qwen3.8-Flash-Next-Uncensored-NVFP4, i.e. every visual.* tensor except
+# patch_embed, pos_embed and the LayerNorms.
+QWEN_OFFLOADABLE_BYTES = 888_759_008
+QWEN_LARGEST_MODULE_BYTES = 42_476_544  # merger.linear_fc1
+
+
+def _meta_linear(in_f: int, out_f: int, bias: bool = True) -> nn.Linear:
+    return nn.Linear(in_f, out_f, bias=bias, device="meta", dtype=torch.bfloat16)
+
+
+def _qwen_vision_tower_replica() -> nn.Module:
+    """Module tree with the real tower's names, shapes and dtype.
+
+    Built on the meta device, so it costs no memory: only names and parameter
+    sizes matter to `select_offload_modules`, and both are exact here.
+    """
+    hidden, depth, intermediate, out_hidden, merge = 1152, 27, 4304, 2560, 2
+    merged = hidden * merge**2
+
+    def _norm(dim: int) -> nn.Module:
+        return nn.LayerNorm(dim, device="meta", dtype=torch.bfloat16)
+
+    tower = nn.Module()
+    tower.patch_embed = nn.Module()
+    tower.patch_embed.proj = nn.Conv3d(
+        3, hidden, (2, 16, 16), stride=(2, 16, 16),
+        device="meta", dtype=torch.bfloat16,
+    )
+    tower.pos_embed = nn.Embedding(2304, hidden, device="meta", dtype=torch.bfloat16)
+
+    blocks = nn.ModuleList()
+    for _ in range(depth):
+        block = nn.Module()
+        block.norm1 = _norm(hidden)
+        block.norm2 = _norm(hidden)
+        block.attn = nn.Module()
+        block.attn.qkv = _meta_linear(hidden, 3 * hidden)
+        block.attn.proj = _meta_linear(hidden, hidden)
+        block.mlp = nn.Module()
+        block.mlp.linear_fc1 = _meta_linear(hidden, intermediate)
+        block.mlp.linear_fc2 = _meta_linear(intermediate, hidden)
+        blocks.append(block)
+    tower.blocks = blocks
+
+    tower.merger = nn.Module()
+    tower.merger.norm = _norm(hidden)
+    tower.merger.linear_fc1 = _meta_linear(merged, merged)
+    tower.merger.linear_fc2 = _meta_linear(merged, out_hidden)
+    return tower
+
+
+def test_qwen_tower_selection_is_exactly_the_projections():
+    """The prefixes the model passes must pick every projection and nothing
+    whose weight a kernel reads outside `nn.Module.__call__`."""
+    tower = _qwen_vision_tower_replica()
+    selected = select_offload_modules(
+        tower, include_prefixes=QWEN_TOWER_INCLUDE_PREFIXES
+    )
+    names = _names(selected)
+
+    assert len(names) == 110  # 27 blocks x 4 projections + 2 merger projections
+    assert set(names) == {
+        f"blocks.{i}.{leaf}"
+        for i in range(27)
+        for leaf in ("attn.qkv", "attn.proj", "mlp.linear_fc1", "mlp.linear_fc2")
+    } | {"merger.linear_fc1", "merger.linear_fc2"}
+
+    # pos_embed.weight goes straight to a Triton kernel and patch_embed backs
+    # the tower's .dtype/.device properties: both must stay resident.
+    assert "pos_embed" not in names
+    assert "patch_embed.proj" not in names
+    assert not any(".norm" in name for name in names)
+
+
+def test_qwen_tower_offloadable_bytes_match_the_checkpoint():
+    tower = _qwen_vision_tower_replica()
+    selected = select_offload_modules(
+        tower, include_prefixes=QWEN_TOWER_INCLUDE_PREFIXES
+    )
+    total = sum(module_param_bytes(m) for _, m in selected)
+    assert total == QWEN_OFFLOADABLE_BYTES
+    assert max(module_param_bytes(m) for _, m in selected) == QWEN_LARGEST_MODULE_BYTES
