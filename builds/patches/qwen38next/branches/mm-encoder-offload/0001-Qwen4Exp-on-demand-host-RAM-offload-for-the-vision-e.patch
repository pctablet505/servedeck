+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The launcher's serve line must resolve to the config we documented.
+
+Two layers are pinned here:
+
+1. the argv itself, taken from `serve.sh` under `DRY_RUN=1` with the
+   documented `EXTRA_ARGS` -- because `serve.sh` hardcodes
+   `--limit-mm-per-prompt '{"image":0,"video":0}'` and `EXTRA_ARGS` is
+   word-split *after* it, so whether images are on at all depends on argparse
+   letting the later occurrence win, and on the JSON surviving an unquoted
+   `${EXTRA_ARGS}` expansion;
+2. the `EngineArgs` those arguments resolve to -- the values that decide how
+   much VRAM the multimodal path costs.
+
+A future edit to either the launcher or the arg wiring that quietly re-enables
+a resident vision tower fails here instead of at 3 a.m. on the box.
+"""
+
+import os
+import re
+import shutil
+import subprocess
+
+import pytest
+
+from vllm.config.offload import OffloadConfig
+from vllm.engine.arg_utils import EngineArgs
+from vllm.utils.argparse_utils import FlexibleArgumentParser
+
+#: The one string the owner pastes into `local_llm/.config`. Single source of
+#: truth for this file: everything below is derived from it.
+#:
+#: The JSON values carry no quotes and no spaces on purpose. `serve.sh`
+#: expands `${EXTRA_ARGS:-}` unquoted, so word splitting is the only thing that
+#: happens to this string -- quote removal is not, and `'{"image":2}'` would
+#: reach vLLM with its apostrophes attached.
+DOCUMENTED_EXTRA_ARGS = (
+    "--mamba-ssm-cache-dtype bfloat16 "
+    "--prefix-match-unit 208 "
+    "--mm-encoder-offload onload "
+    "--limit-mm-per-prompt.image 2 "
+    "--limit-mm-per-prompt.video 0 "
+    "--mm-processor-kwargs.max_pixels 2097152 "
+    "--mm-processor-cache-gb 0.5"
+)
+
+#: `local_llm/llm` reads `.config` with this bash regex and *silently skips*
+#: any line it does not match. The value class is `[^"]*`, so a double quote
+#: anywhere in EXTRA_ARGS drops the whole line -- and with it
+#: --mamba-ssm-cache-dtype and --prefix-match-unit, not just the new flags.
+#: That is why the multimodal settings are spelled as dotted sub-arguments
+#: instead of the JSON forms `--limit-mm-per-prompt {"image":2,"video":0}` and
+#: `--mm-processor-kwargs {"max_pixels":2097152}`.
+LLM_CONFIG_LINE_RE = re.compile(r'^[ \t]*([A-Z_]+)="([^"]*)"[ \t]*$')
+
+LAUNCHER = "/home/pctablet505/Projects/vllm-qwen38next/serve.sh"
+
+# The launcher-independent tail, for the parse-level assertions. Mirrors what
+# `serve.sh` builds; `test_launcher_argv_matches_the_documented_args` is what
+# proves the mirror is honest.
+DOCUMENTED_MM_ARGS = [
+    "--max-model-len",
+    "262144",
+    "--gpu-memory-utilization",
+    "0.95",
+    "--max-num-seqs",
+    "16",
+    "--max-num-batched-tokens",
+    "8192",
+    "--limit-mm-per-prompt",
+    '{"image":0,"video":0}',  # serve.sh's hardcoded text-only default ...
+    *DOCUMENTED_EXTRA_ARGS.split(),  # ... which EXTRA_ARGS must override
+]
+
+#: serve.sh passes these to the API server; EngineArgs does not own them.
+NOT_ENGINE_ARGS = {
+    "--host": 1,
+    "--port": 1,
+    "--enable-auto-tool-choice": 0,
+    "--tool-call-parser": 1,
+}
+
+
+def _parse(argv: list[str]) -> EngineArgs:
+    parser = FlexibleArgumentParser()
+    parser = EngineArgs.add_cli_args(parser)
+    return EngineArgs.from_cli_args(parser.parse_args(argv))
+
+
+@pytest.fixture(scope="module")
+def documented_args() -> EngineArgs:
+    return _parse(DOCUMENTED_MM_ARGS)
+
+
+def test_language_model_only_is_off(documented_args: EngineArgs):
+    """The whole point of the change: images are enabled again."""
+    assert documented_args.language_model_only is False
+
+
+def test_encoder_offload_mode_is_onload(documented_args: EngineArgs):
+    assert documented_args.mm_encoder_offload == "onload"
+
+
+def test_encoder_offload_defaults_to_off():
+    """Omitting the flag must not change any other deployment's behaviour."""
+    assert _parse([]).mm_encoder_offload == "none"
+    assert OffloadConfig().mm_encoder_offload == "none"
+
+
+def test_encoder_offload_rejects_an_unknown_mode():
+    with pytest.raises(SystemExit):
+        _parse(["--mm-encoder-offload", "swap"])
+
+
+def test_extra_args_override_the_launchers_hardcoded_text_only_limits(
+    documented_args: EngineArgs,
+):
+    """serve.sh hardcodes image=0,video=0 and appends EXTRA_ARGS after it.
+    FlexibleArgumentParser collects `--limit-mm-per-prompt.image 2` into a dict
+    and re-appends it as JSON at the end of argv, so the dotted form wins. If
+    that ever stopped being true the server would boot silently text-only and
+    this feature would be dead on arrival."""
+    limits = documented_args.limit_mm_per_prompt
+    assert limits["image"] == 2
+    assert limits["video"] == 0
+
+
+def test_max_pixels_is_capped(documented_args: EngineArgs):
+    """max_pixels bounds tokens-per-image, which bounds the profiled encoder
+    batch. Uncapped, this checkpoint's preprocessor allows 16.7 Mpx =
+    16,384 tokens per image; 2 Mpx caps it at 2,048."""
+    assert documented_args.mm_processor_kwargs["max_pixels"] == 2_097_152
+
+
+def test_processor_cache_is_small(documented_args: EngineArgs):
+    """Host RAM, not VRAM - but this box already holds a 95 GiB PLE table."""
+    assert documented_args.mm_processor_cache_gb == 0.5
+
+
+def test_offload_config_carries_the_mode_through():
+    """EngineArgs -> OffloadConfig is the hop the worker actually reads."""
+    config = OffloadConfig(mm_encoder_offload="onload")
+    assert config.mm_encoder_offload == "onload"
+    assert config.compute_hash() != OffloadConfig().compute_hash()
+
+
+# --------------------------------------------------------------------------
+# the launcher itself
+# --------------------------------------------------------------------------
+
+
+def _launcher_argv() -> list[str]:
+    """`serve.sh`'s argv for the documented config, via its DRY_RUN hook."""
+    env = {
+        **os.environ,
+        "DRY_RUN": "1",
+        "DRY_RUN_FORMAT": "nul",
+        "PORT": "8001",
+        "MAX_LEN": "262144",
+        "MAX_SEQS": "16",
+        "GPU_UTIL": "0.95",
+        "SERVED_NAME": "qwen38-flash-next",
+        "EXTRA_ARGS": DOCUMENTED_EXTRA_ARGS,
+    }
+    out = subprocess.run(
+        [shutil.which("bash") or "bash", LAUNCHER],
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=120,
+        check=True,
+    ).stdout
+    return [arg for arg in out.split("\0") if arg]
+
+
+@pytest.mark.skipif(
+    not os.path.exists(LAUNCHER), reason="box-local launcher not present"
+)
+def test_launcher_argv_matches_the_documented_args():
+    """The JSON must arrive as one word with no stray quotes, and the
+    overriding --limit-mm-per-prompt must come after the hardcoded one."""
+    argv = _launcher_argv()
+
+    assert argv[argv.index("--limit-mm-per-prompt") + 1] == '{"image":0,"video":0}'
+    assert argv[argv.index("--limit-mm-per-prompt.image") + 1] == "2"
+    assert argv[argv.index("--limit-mm-per-prompt.video") + 1] == "0"
+    assert argv[argv.index("--mm-encoder-offload") + 1] == "onload"
+    assert argv[argv.index("--mm-processor-kwargs.max_pixels") + 1] == "2097152"
+    assert argv[argv.index("--mm-processor-cache-gb") + 1] == "0.5"
+    assert "--language-model-only" not in argv
+    assert argv.index("--limit-mm-per-prompt") < argv.index(
+        "--limit-mm-per-prompt.image"
+    ), "EXTRA_ARGS must land after the launcher's hardcoded limits"
+
+
+@pytest.mark.skipif(
+    not os.path.exists(LAUNCHER), reason="box-local launcher not present"
+)
+def test_launcher_argv_resolves_to_the_documented_engine_args():
+    """End to end: what the launcher runs is what we said it costs."""
+    argv = _launcher_argv()
+    # Drop "<venv>/bin/vllm serve <model>", and let the API-server-only flags
+    # (--host, --tool-call-parser, ...) fall through: EngineArgs does not own
+    # them and they have nothing to do with what this feature costs.
+    # Drop "<venv>/bin/vllm serve <model>" and the API-server-only flags, then
+    # use parse_args, not parse_known_args: the dotted-subargument handling
+    # that makes --limit-mm-per-prompt.image work lives in
+    # FlexibleArgumentParser.parse_args and parse_known_args goes around it.
+    engine_argv: list[str] = []
+    i = 3
+    while i < len(argv):
+        if argv[i] in NOT_ENGINE_ARGS:
+            i += 1 + NOT_ENGINE_ARGS[argv[i]]
+            continue
+        engine_argv.append(argv[i])
+        i += 1
+    args = _parse(engine_argv)
+
+    assert args.language_model_only is False
+    assert args.mm_encoder_offload == "onload"
+    assert args.limit_mm_per_prompt == {"image": 2, "video": 0}
+    assert args.mm_processor_kwargs["max_pixels"] == 2_097_152
+    assert args.mm_processor_cache_gb == 0.5
+    assert args.gpu_memory_utilization == 0.95
+    assert args.max_num_seqs == 16
+
+
+def test_the_config_line_survives_the_llm_readers_regex():
+    """`llm` skips a `.config` line it cannot match, without a word of warning.
+    A JSON spelling of these flags contains double quotes, which that regex
+    forbids -- the line would vanish and take --mamba-ssm-cache-dtype and
+    --prefix-match-unit down with it."""
+    line = f'EXTRA_ARGS="{DOCUMENTED_EXTRA_ARGS}"'
+    match = LLM_CONFIG_LINE_RE.match(line)
+    assert match is not None, line
+    assert match.group(1) == "EXTRA_ARGS"
+    assert match.group(2) == DOCUMENTED_EXTRA_ARGS
+    assert match.group(2).split() == DOCUMENTED_EXTRA_ARGS.split()
+
+
+def test_the_config_line_has_nothing_the_shell_would_reinterpret():
+    """serve.sh expands ${EXTRA_ARGS:-} unquoted, so word splitting is the only
+    thing that may happen to it: no quotes to leave attached, no glob character
+    to expand against the cwd, no $ to substitute."""
+    assert not set(DOCUMENTED_EXTRA_ARGS) & set("\"'$`*?[]\\")
