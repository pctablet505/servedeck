index 000000000..f0b78ea01
--- /dev/null
+++ b/vllm/model_executor/offloader/mm_encoder.py
@@ -0,0 +1,274 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""On-demand host-RAM offloading for the multimodal (vision) encoder.
+
+Motivation
+----------
+On a single-GPU deployment the KV cache is sized to consume whatever VRAM is
+left after the weights, so every byte the vision tower holds is a byte the KV
+cache does not get.  For a text-heavy workload with occasional images that is a
+bad trade: the tower is idle for ~100% of the forward passes yet is charged for
+100% of the time.  The usual escape hatch (``--language-model-only``) buys the
+VRAM back by removing multimodal support entirely.
+
+This module keeps the tower's weights in *host* RAM and pays PCIe only while an
+image is actually being encoded.
+
+Modes
+-----
+``onload``
+    Weights live in pinned host memory.  A forward pre-hook copies one
+    submodule's parameters to the device just before that submodule runs and a
+    forward hook drops them again, so the device holds at most one submodule's
+    weights at a time (tens of MiB, not the whole tower).  This is the default
+    because a single-GPU server at ``--gpu-memory-utilization 0.95`` has no
+    headroom to materialise the whole tower on demand.
+
+``uva``
+    Weights live in pinned host memory with a device-accessible view (zero
+    copy).  Device pointers never change, which is what CUDA-graph capture and
+    ``torch.compile`` of the encoder require, at the cost of reading the
+    weights over PCIe from inside the GEMM instead of as one bulk transfer.
+
+Both modes leave ~0 bytes of steady-state VRAM behind.
+
+Scope
+-----
+``select_offload_modules`` deliberately only picks modules that *own*
+parameters and that own enough of them to be worth a PCIe round trip.  A
+``LayerNorm``'s 2 KiB is not; a 10 MiB projection is.  Callers pass an explicit
+prefix allowlist because a module is only safe to offload if every use of its
+parameters goes through ``nn.Module.__call__`` -- a parameter that some kernel
+reads directly (e.g. ``pos_embed.weight`` handed to a Triton kernel) would
+still be on the host when the kernel runs.
+"""
+
+from collections.abc import Iterable, Sequence
+from typing import TYPE_CHECKING, Literal
+
+import torch
+import torch.nn as nn
+
+from vllm.logger import init_logger
+from vllm.model_executor.offloader.base import should_pin_memory
+from vllm.utils.mem_utils import format_gib
+from vllm.utils.platform_utils import is_uva_available
+from vllm.utils.torch_utils import get_accelerator_view_from_cpu_tensor
+
+if TYPE_CHECKING:
+    from vllm.config import VllmConfig
+
+logger = init_logger(__name__)
+
+MMEncoderOffloadMode = Literal["none", "onload", "uva"]
+
+#: Modules whose own parameters total less than this are left on the device.
+#: 1 MiB is well above every norm/bias in a ViT block and well below every
+#: projection matrix, so the split is unambiguous rather than tuned.
+DEFAULT_MIN_OFFLOAD_BYTES = 1 << 20
+
+#: Offloadable subtrees of a Qwen3-VL-style vision tower. Everything under
+#: these prefixes reaches its parameters through ``nn.Module.__call__``, which
+#: is what lets a forward hook move them. Deliberately absent: ``patch_embed``
+#: (backs the tower's ``.dtype``/``.device`` properties) and ``pos_embed``
+#: (its weight is handed straight to a Triton kernel) - 8.4 MiB of a 856 MiB
+#: tower.
+VISION_TOWER_PROJECTION_PREFIXES = ("blocks.", "merger.", "deepstack_merger_list.")
+
+
+def module_param_bytes(module: nn.Module) -> int:
+    """Bytes of the parameters this module owns directly (no recursion)."""
+    return sum(
+        p.numel() * p.element_size() for _, p in module.named_parameters(recurse=False)
+    )
+
+
+def select_offload_modules(
+    root: nn.Module,
+    *,
+    include_prefixes: Sequence[str] | None = None,
+    exclude_prefixes: Sequence[str] = (),
+    min_bytes: int = DEFAULT_MIN_OFFLOAD_BYTES,
+) -> list[tuple[str, nn.Module]]:
+    """Pick the submodules of ``root`` whose weights are worth offloading.
+
+    A module qualifies when all of the following hold:
+
+    * it owns parameters directly -- containers are never selected, so a
+      module's bytes are counted once and hooks fire exactly once per module;
+    * those parameters total at least ``min_bytes``;
+    * its dotted name starts with one of ``include_prefixes`` (when given);
+    * its dotted name starts with none of ``exclude_prefixes``.
+
+    Returns ``(name, module)`` pairs in ``named_modules`` order.
+    """
+
+    def _matches(name: str, prefixes: Iterable[str]) -> bool:
+        return any(name == p.rstrip(".") or name.startswith(p) for p in prefixes)
+
+    selected: list[tuple[str, nn.Module]] = []
+    for name, module in root.named_modules():
+        if not name:
+            continue
+        if include_prefixes is not None and not _matches(name, include_prefixes):
+            continue
+        if exclude_prefixes and _matches(name, exclude_prefixes):
+            continue
+        if module_param_bytes(module) < min_bytes:
+            continue
+        selected.append((name, module))
+    return selected
+
+
+class MMEncoderOffloader:
+    """Moves selected encoder submodules to host RAM and back on demand.
+
+    The offloader owns the pinned host copies, so it must outlive the model.
+    ``onload_calls``/``free_calls`` are exposed for tests and for a one-line
+    sanity check in the logs.
+    """
+
+    def __init__(
+        self,
+        mode: MMEncoderOffloadMode,
+        device: torch.device | str,
+        *,
+        min_bytes: int = DEFAULT_MIN_OFFLOAD_BYTES,
+        pin_memory: bool | None = None,
+    ) -> None:
+        if mode not in ("none", "onload", "uva"):
+            raise ValueError(f"Unknown mm encoder offload mode: {mode!r}")
+        self.mode: MMEncoderOffloadMode = mode
+        self.device = torch.device(device)
+        self.min_bytes = min_bytes
+        self.pin_memory = should_pin_memory() if pin_memory is None else pin_memory
+
+        self.offloaded_bytes = 0
+        self.offloaded_modules: list[str] = []
+        self.onload_calls = 0
+        self.free_calls = 0
+        # name -> {param name: pinned host tensor}
+        self._host_params: dict[str, dict[str, torch.Tensor]] = {}
+        self._handles: list[torch.utils.hooks.RemovableHandle] = []
+
+    def offload(
+        self,
+        root: nn.Module,
+        *,
+        include_prefixes: Sequence[str] | None = None,
+        exclude_prefixes: Sequence[str] = (),
+    ) -> int:
+        """Offload the qualifying submodules of ``root``. Returns bytes moved."""
+        if self.mode == "none":
+            return 0
+
+        if self.mode == "uva" and not is_uva_available():
+            raise RuntimeError(
+                "mm_encoder_offload='uva' requires unified virtual addressing, "
+                "which this platform does not provide. Use 'onload' instead."
+            )
+
+        selected = select_offload_modules(
+            root,
+            include_prefixes=include_prefixes,
+            exclude_prefixes=exclude_prefixes,
+            min_bytes=self.min_bytes,
+        )
+        for name, module in selected:
+            self._offload_module(name, module)
+
+        logger.info(
+            "Multimodal encoder offload (%s): %d modules, %s moved to host RAM",
+            self.mode,
+            len(self.offloaded_modules),
+            format_gib(self.offloaded_bytes),
+        )
+        return self.offloaded_bytes
+
+    def _offload_module(self, name: str, module: nn.Module) -> None:
+        host: dict[str, torch.Tensor] = {}
+        for pname, p in module.named_parameters(recurse=False):
+            cpu_data = p.data.to(device="cpu")
+            if self.pin_memory and not cpu_data.is_pinned():
+                cpu_data = cpu_data.pin_memory()
+            host[pname] = cpu_data
+            self.offloaded_bytes += cpu_data.numel() * cpu_data.element_size()
+            if self.mode == "uva":
+                p.data = get_accelerator_view_from_cpu_tensor(cpu_data)
+                p._vllm_is_uva_offloaded = True
+            else:
+                p.data = cpu_data
+
+        if not host:
+            return
+
+        self._host_params[name] = host
+        self.offloaded_modules.append(name)
+
+        if self.mode == "onload":
+            self._handles.append(
+                module.register_forward_pre_hook(self._make_onload_hook(name))
+            )
+            self._handles.append(
+                module.register_forward_hook(self._make_free_hook(name))
+            )
+
+    def _to_device(self, tensor: torch.Tensor) -> torch.Tensor:
+        """The host-to-device transfer. Overridden in tests, which have no
+        accelerator to move to and need the copy to be observable."""
+        return tensor.to(self.device, non_blocking=self.pin_memory)
+
+    def _make_onload_hook(self, name: str):
+        def _onload(module: nn.Module, args):  # noqa: ANN001
+            self.onload_calls += 1
+            host = self._host_params[name]
+            for pname, p in module.named_parameters(recurse=False):
+                p.data = self._to_device(host[pname])
+            return None
+
+        return _onload
+
+    def _make_free_hook(self, name: str):
+        def _free(module: nn.Module, args, output):  # noqa: ANN001
+            self.free_calls += 1
+            host = self._host_params[name]
+            for pname, p in module.named_parameters(recurse=False):
+                p.data = host[pname]
+            return None
+
+        return _free
+
+    def close(self) -> None:
+        """Remove the hooks. The host copies stay valid until dropped."""
+        for handle in self._handles:
+            handle.remove()
+        self._handles.clear()
+
+
+def resolve_mm_encoder_offload_mode(
+    vllm_config: "VllmConfig",
+) -> MMEncoderOffloadMode:
+    """Read the requested mode off the config and reject unsafe combinations.
+
+    ``onload`` swaps device pointers between forward passes, which a captured
+    CUDA graph or a compiled encoder graph would have baked in. ``uva`` keeps
+    pointers stable and is the answer for those setups, so we say so rather
+    than silently producing wrong pixels.
+    """
+    mode: MMEncoderOffloadMode = vllm_config.offload_config.mm_encoder_offload
+    if mode == "none":
+        return mode
+
+    compilation_config = vllm_config.compilation_config
+    if mode == "onload" and (
+        getattr(compilation_config, "compile_mm_encoder", False)
+        or getattr(compilation_config, "cudagraph_mm_encoder", False)
+    ):
+        raise ValueError(
+            "mm_encoder_offload='onload' is incompatible with "
+            "compile_mm_encoder/cudagraph_mm_encoder: both capture the "
+            "encoder's weight pointers, which onload changes on every "
+            "forward. Use mm_encoder_offload='uva' (stable pointers) or "
+            "disable encoder compilation/CUDA graphs."
+        )
+    return mode
