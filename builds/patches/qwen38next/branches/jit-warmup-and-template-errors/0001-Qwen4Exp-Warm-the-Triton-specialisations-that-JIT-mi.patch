@@ -0,0 +1,316 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The Qwen4Exp JIT warmup plan must cover every specialisation serving reaches.
+
+Every Triton specialisation missing from the plan is a kernel that compiles
+mid-request and stalls it, which is exactly what the JIT monitor reports in
+`serve.log`.  These tests sweep the reachable dispatch space on CPU and assert
+the plan's key set is a superset of what the sweep produces.
+"""
+
+import pytest
+
+from vllm.model_executor.warmup.qwen4_exp_jit_warmup import (
+    GUMBEL_KERNEL,
+    LOCAL_LOGITS_STATS_KERNEL,
+    QSA_MERGE_KERNEL,
+    QSA_MQA_KERNEL,
+    QSA_SPARSE_KERNEL,
+    REJECTION_KERNEL,
+    RESAMPLE_KERNEL,
+    SPEC_DIVISIBLE_BY_16,
+    SPEC_EQUAL_TO_1,
+    SPEC_GENERAL,
+    WARMED_KERNELS,
+    Qwen4ExpWarmupConfig,
+    build_warmup_plan,
+    gumbel_key,
+    qsa_mqa_key,
+    qsa_sparse_keys,
+    rejection_keys,
+    triton_int_spec,
+)
+
+# The live Qwen3.8-Flash-Next deployment (24 q heads / 2 kv heads, head_dim 256,
+# indexer budget 2048 at compress ratio 4, MTP-3, max_num_seqs 16).
+LIVE_CONFIG = Qwen4ExpWarmupConfig(
+    num_query_heads=24,
+    num_kv_heads=2,
+    head_dim=256,
+    kv_page_size=64,
+    kv_page_table_width=4096,
+    num_kv_pages=4546,
+    kv_dtype="bfloat16",
+    index_n_heads=4,
+    index_head_dim=128,
+    compress_ratio=4,
+    token_topk=2048,
+    compressed_page_size=64,
+    compressed_page_table_width=1024,
+    num_compressed_pages=1024,
+    max_num_seqs=16,
+    max_num_batched_tokens=8192,
+    num_speculative_tokens=3,
+    vocab_size=248320,
+    logits_dtype="float32",
+    use_fp64_gumbel=False,
+    has_draft_logits=True,
+    use_block_verification=False,
+    use_synthetic_rates=False,
+)
+
+# The pre-tuning single-sequence deployment that produced serve.log.131k.
+SINGLE_SEQ_CONFIG = Qwen4ExpWarmupConfig(
+    **{
+        **LIVE_CONFIG.__dict__,
+        "max_num_seqs": 1,
+        "compressed_page_table_width": 512,
+        "kv_page_table_width": 2048,
+    }
+)
+
+# A TP-shaped variant: one KV head moves every profile bucket boundary.
+SINGLE_KV_HEAD_CONFIG = Qwen4ExpWarmupConfig(
+    **{**LIVE_CONFIG.__dict__, "num_kv_heads": 1, "num_query_heads": 12}
+)
+
+ALL_CONFIGS = [LIVE_CONFIG, SINGLE_SEQ_CONFIG, SINGLE_KV_HEAD_CONFIG]
+CONFIG_IDS = ["live", "single_seq", "single_kv_head"]
+
+# Rows the scheduler can hand the QSA kernels. Dense through every profile
+# boundary, then sparse out to a full 8192-token chunked prefill.
+SWEEP_ROWS = list(range(1, 620)) + [640, 700, 1024, 2047, 4096, 8191, 8192]
+
+
+def _sweep_req_counts(rows: int, max_num_seqs: int) -> list[int]:
+    ceiling = max(1, min(rows, max_num_seqs))
+    return sorted({1, 2, 3, ceiling - 1, ceiling} & set(range(1, ceiling + 1)))
+
+
+@pytest.mark.parametrize("cfg", ALL_CONFIGS, ids=CONFIG_IDS)
+def test_plan_names_every_kernel_the_jit_monitor_reported(cfg):
+    """Each kernel seen compiling mid-inference must appear in the plan."""
+    plan = build_warmup_plan(cfg)
+    assert plan.kernels() == WARMED_KERNELS
+
+
+@pytest.mark.parametrize("cfg", ALL_CONFIGS, ids=CONFIG_IDS)
+def test_plan_covers_every_reachable_sparse_attention_specialisation(cfg):
+    """No `(profile bucket, integer specialisation)` pair may be missing."""
+    plan = build_warmup_plan(cfg)
+    sparse_keys = plan.keys_for(QSA_SPARSE_KERNEL)
+    merge_keys = plan.keys_for(QSA_MERGE_KERNEL)
+
+    missing_sparse = set()
+    missing_merge = set()
+    for rows in SWEEP_ROWS:
+        if rows > cfg.max_num_batched_tokens:
+            continue
+        for num_reqs in _sweep_req_counts(rows, cfg.max_num_seqs):
+            sparse, merge = qsa_sparse_keys(cfg, rows, num_reqs)
+            if sparse not in sparse_keys:
+                missing_sparse.add((rows, num_reqs, sparse))
+            if merge is not None and merge not in merge_keys:
+                missing_merge.add((rows, num_reqs, merge))
+
+    assert not missing_sparse, f"unwarmed sparse specialisations: {missing_sparse}"
+    assert not missing_merge, f"unwarmed merge specialisations: {missing_merge}"
+
+
+@pytest.mark.parametrize("cfg", ALL_CONFIGS, ids=CONFIG_IDS)
+def test_plan_covers_every_reachable_mqa_specialisation(cfg):
+    """`TILES_PER_PROG` and the row/request integer classes must all be warmed."""
+    plan = build_warmup_plan(cfg)
+    mqa_keys = plan.keys_for(QSA_MQA_KERNEL)
+
+    missing = set()
+    for rows in SWEEP_ROWS:
+        if rows > cfg.mqa_max_rows:
+            continue
+        for num_reqs in _sweep_req_counts(rows, cfg.max_num_seqs):
+            key = qsa_mqa_key(cfg, rows, num_reqs)
+            if key not in mqa_keys:
+                missing.add((rows, num_reqs, key))
+
+    assert not missing, f"unwarmed MQA specialisations: {missing}"
+
+
+def test_sweep_actually_reaches_the_buckets_warmup_missed():
+    """Guard the guard: the sweep must exercise every profile bucket.
+
+    A sweep that only produced one bucket would make the coverage tests above
+    pass vacuously.
+    """
+    cfg = LIVE_CONFIG
+    buckets = {
+        (k.block_n, k.num_splits, k.num_warps)
+        for rows in SWEEP_ROWS
+        if rows <= cfg.max_num_batched_tokens
+        for k in [qsa_sparse_keys(cfg, rows, 1)[0]]
+    }
+    assert len(buckets) == 5, buckets
+
+    tiles = {
+        qsa_mqa_key(cfg, rows, 1).tiles_per_prog
+        for rows in SWEEP_ROWS
+        if rows <= cfg.mqa_max_rows
+    }
+    assert tiles == {1, 8}
+
+    specs = {
+        qsa_sparse_keys(cfg, rows, 1)[0].rows_spec
+        for rows in SWEEP_ROWS
+        if rows <= cfg.max_num_batched_tokens
+    }
+    assert specs == {SPEC_EQUAL_TO_1, SPEC_DIVISIBLE_BY_16, SPEC_GENERAL}
+
+
+@pytest.mark.parametrize("cfg", ALL_CONFIGS, ids=CONFIG_IDS)
+def test_plan_covers_both_gumbel_call_sites(cfg):
+    """Sampler (no logits cache) and draft sampling (cached) are distinct binaries."""
+    plan = build_warmup_plan(cfg)
+    gumbel = plan.keys_for(GUMBEL_KERNEL)
+    sampler_site = gumbel_key(
+        cfg, apply_temperature=False, has_logits_cache=False, per_token_col=False
+    )
+    assert sampler_site in gumbel
+    if cfg.has_draft_logits:
+        draft_site = gumbel_key(
+            cfg, apply_temperature=True, has_logits_cache=True, per_token_col=False
+        )
+        assert draft_site in gumbel
+
+
+@pytest.mark.parametrize("cfg", ALL_CONFIGS, ids=CONFIG_IDS)
+def test_plan_covers_the_speculation_verification_kernels(cfg):
+    plan = build_warmup_plan(cfg)
+    stats, rejection, resample = rejection_keys(cfg)
+    assert stats in plan.keys_for(LOCAL_LOGITS_STATS_KERNEL)
+    assert rejection in plan.keys_for(REJECTION_KERNEL)
+    assert resample in plan.keys_for(RESAMPLE_KERNEL)
+
+
+def test_speculation_kernels_are_dropped_without_a_drafter():
+    cfg = Qwen4ExpWarmupConfig(
+        **{
+            **LIVE_CONFIG.__dict__,
+            "num_speculative_tokens": 0,
+            "has_draft_logits": False,
+        }
+    )
+    plan = build_warmup_plan(cfg)
+    assert LOCAL_LOGITS_STATS_KERNEL not in plan.kernels()
+    assert REJECTION_KERNEL not in plan.kernels()
+    assert RESAMPLE_KERNEL not in plan.kernels()
+    assert QSA_SPARSE_KERNEL in plan.kernels()
+
+
+@pytest.mark.parametrize("cfg", ALL_CONFIGS, ids=CONFIG_IDS)
+def test_plan_stays_small_enough_to_run_at_boot(cfg):
+    """Over-correction guard: covering everything must not mean compiling everything.
+
+    Warmup runs on the boot path, so a plan that simply enumerated the whole
+    row space would trade one problem for another.
+    """
+    plan = build_warmup_plan(cfg)
+    assert len(plan.launches()) <= 64, len(plan.launches())
+    assert len(plan.entries) <= 80, len(plan.entries)
+
+
+def test_triton_int_spec_matches_triton():
+    """Our model of Triton's runtime-integer specialisation must be the real one."""
+    triton_c = pytest.importorskip("triton._C.libtriton")
+    from triton.backends.compiler import BaseBackend
+
+    for value in (0, 1, 2, 5, 15, 16, 17, 31, 32, 64, 248320, 8192, 2051):
+        dtype, attr = triton_c.native_specialize_impl(
+            BaseBackend, value, False, True, True
+        )
+        if dtype == "constexpr":
+            expected = SPEC_EQUAL_TO_1
+        elif attr == "D":
+            expected = SPEC_DIVISIBLE_BY_16
+        else:
+            expected = SPEC_GENERAL
+        assert triton_int_spec(value) == expected, value
+
+
+# ---------------------------------------------------------------------------
+# Driver input contracts
+#
+# The warmup driver hand-builds the tensors it launches with. These assertions
+# mirror the guards at the top of `qsa_mqa_paged` and
+# `qsa_sparse_paged_attention`: if the driver violates one it raises at boot
+# instead of warming anything, and if it gets a dtype wrong it warms a binary
+# serving never uses.
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("rows,num_reqs", [(1, 1), (5, 2), (48, 16), (272, 16)])
+def test_sparse_driver_inputs_satisfy_the_launcher_contract(rows, num_reqs):
+    torch = pytest.importorskip("torch")
+    from vllm.model_executor.warmup.qwen4_exp_jit_warmup import (
+        QsaDispatch,
+        build_qsa_sparse_inputs,
+    )
+
+    cfg = LIVE_CONFIG
+    cache = torch.zeros(
+        (4, cfg.kv_page_size, cfg.num_kv_heads, cfg.head_dim), dtype=torch.bfloat16
+    )
+    args = build_qsa_sparse_inputs(cfg, cache, cache, QsaDispatch(rows, num_reqs))
+
+    q, out = args["q"], args["out"]
+    indices, block_table = args["logical_indices"], args["block_table"]
+    token_to_req = args["token_to_req"]
+
+    assert q.shape == (rows, cfg.num_query_heads, cfg.head_dim)
+    assert q.dtype == cache.dtype == torch.bfloat16
+    assert q.stride(2) == 1
+    assert out.shape == q.shape and out.dtype == q.dtype and out.stride(2) == 1
+    assert indices.shape == (rows, cfg.selection_width)
+    assert indices.dtype == torch.int32 and indices.stride(1) == 1
+    assert block_table.shape == (num_reqs, cfg.kv_page_table_width)
+    assert block_table.dtype == torch.int32 and block_table.stride(1) == 1
+    assert token_to_req.shape == (rows,)
+    assert token_to_req.dtype == torch.int32 and token_to_req.stride(0) == 1
+    assert cfg.num_query_heads % cfg.num_kv_heads == 0
+    assert cfg.head_dim >= 16 and cfg.head_dim & (cfg.head_dim - 1) == 0
+    # Every K/V load must be masked: no valid request and no valid selection.
+    assert bool((token_to_req < 0).all()) and bool((indices < 0).all())
+    assert bool((block_table < 0).all())
+
+
+@pytest.mark.parametrize("rows,num_reqs", [(1, 1), (5, 2), (48, 16)])
+def test_mqa_driver_inputs_satisfy_the_launcher_contract(rows, num_reqs):
+    torch = pytest.importorskip("torch")
+    from vllm.model_executor.warmup.qwen4_exp_jit_warmup import (
+        QsaDispatch,
+        build_qsa_mqa_inputs,
+    )
+
+    cfg = LIVE_CONFIG
+    cache = torch.zeros(
+        (4, cfg.compressed_page_size, 1, cfg.index_head_dim), dtype=torch.bfloat16
+    )
+    args = build_qsa_mqa_inputs(cfg, cache, QsaDispatch(rows, num_reqs))
+
+    q = args["q"]
+    assert q.shape == (rows, cfg.index_n_heads, cfg.index_head_dim)
+    assert q.dtype == cache.dtype
+    assert args["k_cache"].shape[2] == 1
+    assert args["k_cache"].shape[3] == q.shape[2]
+    assert args["page_table"].shape == (num_reqs, cfg.compressed_page_table_width)
+    assert args["page_table"].dtype == torch.int32
+    assert args["token_to_req"].shape == (rows,)
+    assert args["token_to_req"].dtype == torch.int32
+    assert args["query_positions"].shape == (rows,)
+    # QSAMetadataBuilder allocates logical_positions as int64; a narrower dtype
+    # would warm a kernel binary the server never launches.
+    assert args["query_positions"].dtype == torch.int64
+    assert args["sequence_lengths"].shape == (num_reqs,)
+    assert args["sequence_lengths"].dtype == torch.int32
+    assert args["compress_ratio"] == cfg.compress_ratio
+    # sequence_lengths == 0 makes `visible` zero, so the kernel returns before
+    # its first cache load.
+    assert bool((args["sequence_lengths"] == 0).all())
