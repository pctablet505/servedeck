@@ -0,0 +1,990 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Enumerate and compile the Qwen4Exp Triton specialisations warmup misses.
+
+The JIT monitor (`vllm.utils.jit_monitor`) reports Triton kernels that compile
+*after* the server reports ready.  Every such compile stalls the request that
+triggered it.  On Qwen4Exp the offenders are:
+
+* ``_qsa_sparse_paged_gqa_splitk_kernel`` / ``_qsa_merge_splitk_kernel`` --
+  `qsa_sparse_paged_attention` picks `(BLOCK_N, num_splits, num_warps)` from a
+  five-way bucket on ``num_rows * num_kv_heads``.  The scheduler-driven warmup
+  in `vllm/v1/worker/gpu/warmup.py` prompts each warmup request with only
+  ``decode_query_len + 1`` tokens, so its batches never exceed a couple of
+  hundred rows and the two *large* buckets are never compiled.  The merge
+  kernel additionally keys on ``NUM_SPLITS``, which follows the same bucket.
+* ``_qsa_mqa_paged_kernel`` -- ``TILES_PER_PROG`` flips at 32 rows.  With a
+  small ``max_num_seqs`` warmup never reaches 33 rows at all.
+* ``_gumbel_sample_kernel`` -- warmup samples with
+  `SamplingParams.for_sampler_warmup()`, which sets ``top_k``/``top_p``, so the
+  sampler takes the FlashInfer branch.  A default API request sets neither and
+  takes the Triton Gumbel branch instead.
+* ``_compute_local_logits_stats_kernel`` / ``_rejection_kernel`` /
+  ``_resample_kernel`` -- speculation-path kernels reached only through
+  `rejection_sample`.
+
+On top of the constexprs, Triton specialises every *runtime* integer argument
+into one of three classes (``== 1``, divisible by 16, otherwise), so a warmup
+that hits a bucket at only one divisibility class still leaves a compile for
+serving.  :func:`build_warmup_plan` enumerates the resulting key set from the
+running config; :func:`qwen4_exp_jit_warmup` compiles it.
+
+The driver deliberately launches with *masked-off* inputs: request ids and
+logical token indices are ``-1``, which every QSA kernel treats as "not
+visible" and skips, and page tables are ``-1`` so no cache load is ever
+unmasked.  Triton compiles on shapes and specialisation classes, not on data,
+so this warms the exact binaries serving will use while touching no KV bytes.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+from vllm.logger import init_logger
+
+if TYPE_CHECKING:
+    import torch
+
+    from vllm.v1.worker.gpu_worker import Worker
+
+logger = init_logger(__name__)
+
+# Kernel names exactly as the JIT monitor reports them.
+QSA_MQA_KERNEL = "_qsa_mqa_paged_kernel"
+QSA_SPARSE_KERNEL = "_qsa_sparse_paged_gqa_splitk_kernel"
+QSA_MERGE_KERNEL = "_qsa_merge_splitk_kernel"
+GUMBEL_KERNEL = "_gumbel_sample_kernel"
+LOCAL_LOGITS_STATS_KERNEL = "_compute_local_logits_stats_kernel"
+REJECTION_KERNEL = "_rejection_kernel"
+RESAMPLE_KERNEL = "_resample_kernel"
+
+#: Every kernel this module promises to compile before the server reports ready.
+WARMED_KERNELS = frozenset(
+    {
+        QSA_MQA_KERNEL,
+        QSA_SPARSE_KERNEL,
+        QSA_MERGE_KERNEL,
+        GUMBEL_KERNEL,
+        LOCAL_LOGITS_STATS_KERNEL,
+        REJECTION_KERNEL,
+        RESAMPLE_KERNEL,
+    }
+)
+
+# Triton runtime-integer specialisation classes. Mirrors
+# `triton._C.libtriton.native_specialize_impl`, which returns a `constexpr`
+# binding for 1, the "divisible by 16" attribute for multiples of 16 (0
+# included), and no attribute otherwise.
+SPEC_EQUAL_TO_1 = "eq1"
+SPEC_DIVISIBLE_BY_16 = "div16"
+SPEC_GENERAL = "general"
+
+
+def triton_int_spec(value: int) -> str:
+    """Specialisation class Triton assigns to a runtime integer argument."""
+    if value == 1:
+        return SPEC_EQUAL_TO_1
+    if value % 16 == 0:
+        return SPEC_DIVISIBLE_BY_16
+    return SPEC_GENERAL
+
+
+def _next_power_of_2(value: int) -> int:
+    if value <= 1:
+        return 1
+    return 1 << (value - 1).bit_length()
+
+
+def _cdiv(a: int, b: int) -> int:
+    return -(-a // b)
+
+
+# ---------------------------------------------------------------------------
+# Config
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Qwen4ExpWarmupConfig:
+    """Everything the plan keys on, read off the running engine config."""
+
+    # Main (sparse GQA) attention geometry.
+    num_query_heads: int
+    num_kv_heads: int
+    head_dim: int
+    kv_page_size: int
+    kv_page_table_width: int
+    num_kv_pages: int
+    kv_dtype: str
+
+    # QSA indexer geometry.
+    index_n_heads: int
+    index_head_dim: int
+    compress_ratio: int
+    token_topk: int
+    compressed_page_size: int
+    compressed_page_table_width: int
+    num_compressed_pages: int
+
+    # Scheduler.
+    max_num_seqs: int
+    max_num_batched_tokens: int
+
+    # Sampler / speculation.
+    num_speculative_tokens: int
+    vocab_size: int
+    logits_dtype: str
+    use_fp64_gumbel: bool
+    has_draft_logits: bool
+    use_block_verification: bool
+    use_synthetic_rates: bool
+
+    @property
+    def selection_width(self) -> int:
+        """``TOPK`` seen by the sparse kernel (indexer output width)."""
+        return self.token_topk + self.compress_ratio - 1
+
+    @property
+    def group_size(self) -> int:
+        return self.num_query_heads // self.num_kv_heads
+
+    @property
+    def block_m(self) -> int:
+        return _next_power_of_2(self.group_size)
+
+    @property
+    def mqa_columns(self) -> int:
+        return self.compressed_page_table_width * self.compressed_page_size
+
+    @property
+    def mqa_max_rows(self) -> int:
+        """Largest row count `qsa_select_paged_tokens` ever hands the MQA kernel."""
+        from vllm.models.qwen4_exp.nvidia.ops.qsa import qsa_mqa_rows_per_chunk
+
+        return min(
+            self.max_num_batched_tokens,
+            qsa_mqa_rows_per_chunk(self.mqa_columns),
+        )
+
+
+# ---------------------------------------------------------------------------
+# Compile keys
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class QsaMqaKey:
+    page_size: int
+    page_table_width: int
+    num_heads: int
+    head_dim: int
+    block_n: int
+    block_d: int
+    tiles_per_prog: int
+    stages: int
+    max_n: int
+    compress_ratio: int
+    num_warps: int
+    q_dtype: str
+    rows_spec: str
+    columns_spec: str
+    num_pages_spec: str
+    num_requests_spec: str
+
+
+@dataclass(frozen=True)
+class QsaSparseKey:
+    topk: int
+    page_size: int
+    page_table_width: int
+    group_size: int
+    head_dim: int
+    num_query_heads: int
+    num_splits: int
+    num_tiles: int
+    block_m: int
+    block_n: int
+    num_warps: int
+    num_stages: int
+    q_dtype: str
+    rows_spec: str
+    num_cache_blocks_spec: str
+    num_requests_spec: str
+
+
+@dataclass(frozen=True)
+class QsaMergeKey:
+    head_dim: int
+    num_query_heads: int
+    num_splits: int
+    block_splits: int
+    num_warps: int
+    num_stages: int
+    out_dtype: str
+    rows_spec: str
+
+
+@dataclass(frozen=True)
+class GumbelKey:
+    block_size: int
+    apply_temperature: bool
+    use_fp64: bool
+    per_token_col: bool
+    has_logits_cache: bool
+    logits_dtype: str
+    vocab_spec: str
+    logits_stride_spec: str
+    local_argmax_stride_spec: str
+
+
+@dataclass(frozen=True)
+class LocalLogitsStatsKey:
+    block_size: int
+    has_draft_logits: bool
+    logits_dtype: str
+    vocab_spec: str
+    num_spec_steps_spec: str
+
+
+@dataclass(frozen=True)
+class RejectionKey:
+    padded_vocab_num_blocks: int
+    has_draft_logits: bool
+    synthetic_mode: bool
+    use_block_verification: bool
+    num_warps: int
+    logits_dtype: str
+    vocab_num_blocks_spec: str
+    sampled_stride_spec: str
+
+
+@dataclass(frozen=True)
+class ResampleKey:
+    block_size: int
+    has_draft_logits: bool
+    use_fp64: bool
+    use_block_verification: bool
+    logits_dtype: str
+    vocab_spec: str
+
+
+# ---------------------------------------------------------------------------
+# Dispatch: one batch shape -> the compile keys it would produce
+# ---------------------------------------------------------------------------
+
+_VOCAB_BLOCK_SIZE = 8192
+_RESAMPLE_BLOCK_SIZE = 1024
+_GUMBEL_BLOCK_SIZE = 1024
+
+
+def qsa_mqa_key(cfg: Qwen4ExpWarmupConfig, rows: int, num_reqs: int) -> QsaMqaKey:
+    """Key `qsa_mqa_paged` produces for a `rows`-row, `num_reqs`-request chunk."""
+    from vllm.models.qwen4_exp.nvidia.ops.qsa import qsa_mqa_tiles_per_program
+
+    return QsaMqaKey(
+        page_size=cfg.compressed_page_size,
+        page_table_width=cfg.compressed_page_table_width,
+        num_heads=cfg.index_n_heads,
+        head_dim=cfg.index_head_dim,
+        block_n=64,
+        block_d=max(16, _next_power_of_2(cfg.index_head_dim)),
+        tiles_per_prog=qsa_mqa_tiles_per_program(rows),
+        stages=2,
+        max_n=max(16, _next_power_of_2(cfg.index_n_heads)),
+        compress_ratio=cfg.compress_ratio,
+        num_warps=2,
+        q_dtype=cfg.kv_dtype,
+        rows_spec=triton_int_spec(rows),
+        columns_spec=triton_int_spec(cfg.mqa_columns),
+        num_pages_spec=triton_int_spec(cfg.num_compressed_pages),
+        num_requests_spec=triton_int_spec(num_reqs),
+    )
+
+
+def qsa_sparse_keys(
+    cfg: Qwen4ExpWarmupConfig, rows: int, num_reqs: int
+) -> tuple[QsaSparseKey, QsaMergeKey | None]:
+    """Keys `qsa_sparse_paged_attention` produces for one batch shape."""
+    from vllm.models.qwen4_exp.nvidia.ops.qsa import (
+        qsa_sparse_launch_profile,
+        qsa_sparse_split_plan,
+    )
+
+    block_m = cfg.block_m
+    block_n, target_splits, partial_warps = qsa_sparse_launch_profile(
+        rows * cfg.num_kv_heads, block_m
+    )
+    num_tiles, num_splits = qsa_sparse_split_plan(
+        cfg.selection_width, block_n, target_splits
+    )
+    sparse = QsaSparseKey(
+        topk=cfg.selection_width,
+        page_size=cfg.kv_page_size,
+        page_table_width=cfg.kv_page_table_width,
+        group_size=cfg.group_size,
+        head_dim=cfg.head_dim,
+        num_query_heads=cfg.num_query_heads,
+        num_splits=num_splits,
+        num_tiles=num_tiles,
+        block_m=block_m,
+        block_n=block_n,
+        num_warps=partial_warps,
+        num_stages=2,
+        q_dtype=cfg.kv_dtype,
+        rows_spec=triton_int_spec(rows),
+        num_cache_blocks_spec=triton_int_spec(cfg.num_kv_pages),
+        num_requests_spec=triton_int_spec(num_reqs),
+    )
+    if num_splits == 1:
+        # Split=1 writes the output directly; the merge kernel is not launched.
+        return sparse, None
+    merge = QsaMergeKey(
+        head_dim=cfg.head_dim,
+        num_query_heads=cfg.num_query_heads,
+        num_splits=num_splits,
+        block_splits=_next_power_of_2(num_splits),
+        num_warps=2,
+        num_stages=1,
+        out_dtype=cfg.kv_dtype,
+        rows_spec=triton_int_spec(rows),
+    )
+    return sparse, merge
+
+
+def gumbel_key(
+    cfg: Qwen4ExpWarmupConfig,
+    *,
+    apply_temperature: bool,
+    has_logits_cache: bool,
+    per_token_col: bool,
+) -> GumbelKey:
+    num_blocks = _cdiv(cfg.vocab_size, _GUMBEL_BLOCK_SIZE)
+    return GumbelKey(
+        block_size=_GUMBEL_BLOCK_SIZE,
+        apply_temperature=apply_temperature,
+        use_fp64=cfg.use_fp64_gumbel,
+        per_token_col=per_token_col,
+        has_logits_cache=has_logits_cache,
+        logits_dtype=cfg.logits_dtype,
+        vocab_spec=triton_int_spec(cfg.vocab_size),
+        logits_stride_spec=triton_int_spec(cfg.vocab_size),
+        local_argmax_stride_spec=triton_int_spec(num_blocks),
+    )
+
+
+def rejection_keys(
+    cfg: Qwen4ExpWarmupConfig,
+) -> tuple[LocalLogitsStatsKey, RejectionKey, ResampleKey]:
+    vocab_num_blocks = _cdiv(cfg.vocab_size, _VOCAB_BLOCK_SIZE)
+    stats = LocalLogitsStatsKey(
+        block_size=_VOCAB_BLOCK_SIZE,
+        has_draft_logits=cfg.has_draft_logits,
+        logits_dtype=cfg.logits_dtype,
+        vocab_spec=triton_int_spec(cfg.vocab_size),
+        num_spec_steps_spec=triton_int_spec(cfg.num_speculative_tokens),
+    )
+    rejection = RejectionKey(
+        padded_vocab_num_blocks=_next_power_of_2(vocab_num_blocks),
+        has_draft_logits=cfg.has_draft_logits,
+        synthetic_mode=cfg.use_synthetic_rates,
+        use_block_verification=cfg.use_block_verification,
+        num_warps=1,
+        logits_dtype=cfg.logits_dtype,
+        vocab_num_blocks_spec=triton_int_spec(vocab_num_blocks),
+        sampled_stride_spec=triton_int_spec(cfg.num_speculative_tokens + 1),
+    )
+    resample = ResampleKey(
+        block_size=_RESAMPLE_BLOCK_SIZE,
+        has_draft_logits=cfg.has_draft_logits,
+        use_fp64=cfg.use_fp64_gumbel,
+        use_block_verification=cfg.use_block_verification,
+        logits_dtype=cfg.logits_dtype,
+        vocab_spec=triton_int_spec(cfg.vocab_size),
+    )
+    return stats, rejection, resample
+
+
+# ---------------------------------------------------------------------------
+# Plan
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class QsaDispatch:
+    """A QSA batch shape the driver has to launch."""
+
+    rows: int
+    num_reqs: int
+
+
+@dataclass(frozen=True)
+class GumbelDispatch:
+    apply_temperature: bool
+    has_logits_cache: bool
+    per_token_col: bool
+
+
+@dataclass(frozen=True)
+class RejectionDispatch:
+    pass
+
+
+@dataclass(frozen=True)
+class WarmupEntry:
+    kernel: str
+    key: Any
+    driver: str
+    dispatch: Any
+
+
+@dataclass(frozen=True)
+class WarmupPlan:
+    config: Qwen4ExpWarmupConfig
+    entries: tuple[WarmupEntry, ...]
+
+    def kernels(self) -> frozenset[str]:
+        return frozenset(entry.kernel for entry in self.entries)
+
+    def keys_for(self, kernel: str) -> frozenset[Any]:
+        return frozenset(e.key for e in self.entries if e.kernel == kernel)
+
+    def launches(self) -> tuple[tuple[str, Any], ...]:
+        """Deduplicated `(driver, dispatch)` pairs, in plan order."""
+        seen: dict[tuple[str, Any], None] = {}
+        for entry in self.entries:
+            seen[(entry.driver, entry.dispatch)] = None
+        return tuple(seen)
+
+
+# Row counts chosen to straddle every profile boundary in `qsa.py` at each of
+# the three Triton integer-specialisation classes. Values above the limits are
+# clamped away in `_row_candidates`.
+_ROW_CANDIDATES = (
+    1, 2, 3, 4, 5, 15, 16, 17, 31, 32, 33, 48, 49, 63, 64, 65,
+    127, 128, 129, 144, 145, 255, 256, 257, 272, 273, 511, 512, 513, 528,
+)  # fmt: skip
+
+# `page_table.shape[0]` is the batch's request count; it is an independent
+# runtime integer, so each of its specialisation classes needs covering too.
+_REQ_CANDIDATES = (1, 2, 16, 17)
+
+
+#: Above this row count no QSA specialisation changes: the largest profile
+#: bucket is already reached and both remaining integer-specialisation classes
+#: are covered, so the plan stops here instead of allocating serving-sized
+#: dummy tensors during warmup.
+_MAX_PLANNED_ROWS = max(_ROW_CANDIDATES)
+#: `_qsa_mqa_paged_kernel` only switches on `TILES_PER_PROG`, which flips at 32.
+_MAX_PLANNED_MQA_ROWS = 65
+
+
+def _row_candidates(limit: int, cap: int = _MAX_PLANNED_ROWS) -> tuple[int, ...]:
+    limit = max(1, min(limit, cap))
+    rows = {r for r in _ROW_CANDIDATES if r <= limit}
+    # Always cover the extremes the scheduler can actually produce.
+    rows.add(1)
+    rows.add(limit)
+    return tuple(sorted(rows))
+
+
+def _req_candidates(rows: int, max_num_seqs: int) -> tuple[int, ...]:
+    ceiling = max(1, min(rows, max_num_seqs))
+    reqs = {r for r in _REQ_CANDIDATES if r <= ceiling}
+    reqs.add(1)
+    reqs.add(ceiling)
+    return tuple(sorted(reqs))
+
+
+def build_warmup_plan(cfg: Qwen4ExpWarmupConfig) -> WarmupPlan:
+    """Enumerate the Triton specialisations Qwen4Exp serving can reach."""
+    entries: list[WarmupEntry] = []
+    seen_keys: set[tuple[str, Any]] = set()
+
+    def add(kernel: str, key: Any, driver: str, dispatch: Any) -> None:
+        if (kernel, key) in seen_keys:
+            return
+        seen_keys.add((kernel, key))
+        entries.append(WarmupEntry(kernel, key, driver, dispatch))
+
+    # --- QSA scoring (indexer) -------------------------------------------
+    for rows in _row_candidates(cfg.mqa_max_rows, _MAX_PLANNED_MQA_ROWS):
+        for num_reqs in _req_candidates(rows, cfg.max_num_seqs):
+            add(
+                QSA_MQA_KERNEL,
+                qsa_mqa_key(cfg, rows, num_reqs),
+                "qsa_mqa",
+                QsaDispatch(rows, num_reqs),
+            )
+
+    # --- QSA sparse attention + split-k merge ----------------------------
+    for rows in _row_candidates(cfg.max_num_batched_tokens):
+        for num_reqs in _req_candidates(rows, cfg.max_num_seqs):
+            sparse, merge = qsa_sparse_keys(cfg, rows, num_reqs)
+            dispatch = QsaDispatch(rows, num_reqs)
+            add(QSA_SPARSE_KERNEL, sparse, "qsa_sparse", dispatch)
+            if merge is not None:
+                add(QSA_MERGE_KERNEL, merge, "qsa_sparse", dispatch)
+
+    # --- Gumbel sampling --------------------------------------------------
+    # Two call sites: `Sampler` (no logits cache, temperature pre-applied) and
+    # `Speculator.sample_draft` (caches pre-temperature logits per draft step).
+    gumbel_points = [GumbelDispatch(False, False, False)]
+    if cfg.has_draft_logits:
+        gumbel_points.append(GumbelDispatch(True, True, False))
+        gumbel_points.append(GumbelDispatch(True, True, True))
+    for point in gumbel_points:
+        add(
+            GUMBEL_KERNEL,
+            gumbel_key(
+                cfg,
+                apply_temperature=point.apply_temperature,
+                has_logits_cache=point.has_logits_cache,
+                per_token_col=point.per_token_col,
+            ),
+            "gumbel",
+            point,
+        )
+
+    # --- Speculation verification ----------------------------------------
+    if cfg.num_speculative_tokens > 0:
+        stats, rejection, resample = rejection_keys(cfg)
+        add(LOCAL_LOGITS_STATS_KERNEL, stats, "rejection", RejectionDispatch())
+        add(REJECTION_KERNEL, rejection, "rejection", RejectionDispatch())
+        add(RESAMPLE_KERNEL, resample, "rejection", RejectionDispatch())
+
+    return WarmupPlan(config=cfg, entries=tuple(entries))
+
+
+# ---------------------------------------------------------------------------
+# Reading the config off a live worker
+# ---------------------------------------------------------------------------
+
+
+def _dtype_name(dtype: "torch.dtype") -> str:
+    return str(dtype).removeprefix("torch.")
+
+
+def _block_table_widths(worker: "Worker") -> dict[str, int]:
+    """Map layer name -> its block table's width (the `PAGE_TABLE_WIDTH` constexpr)."""
+    runner = getattr(worker, "model_runner", None)
+    tables = getattr(runner, "block_tables", None)
+    kv_cache_config = getattr(runner, "kv_cache_config", None)
+    widths: dict[str, int] = {}
+    if tables is None or kv_cache_config is None:
+        return widths
+    group_tables = getattr(tables, "block_tables", None)
+    groups = getattr(kv_cache_config, "kv_cache_groups", None)
+    if group_tables is None or groups is None:
+        return widths
+    for group, table in zip(groups, group_tables):
+        tensor = getattr(table, "gpu", table)
+        shape = getattr(tensor, "shape", None)
+        if shape is None or len(shape) < 2:
+            continue
+        for layer_name in group.layer_names:
+            widths[layer_name] = int(shape[1])
+    return widths
+
+
+def _find_qsa_layers(worker: "Worker") -> list[Any]:
+    compilation_config = worker.vllm_config.compilation_config
+    context = getattr(compilation_config, "static_forward_context", None)
+    if not isinstance(context, dict):
+        return []
+    layers = []
+    for module in context.values():
+        if type(module).__name__ == "Qwen4ExpQSAAttention":
+            layers.append(module)
+    return layers
+
+
+def is_qwen4_exp(worker: "Worker") -> bool:
+    architectures = getattr(worker.vllm_config.model_config, "architectures", []) or []
+    return any(str(arch).startswith("Qwen4Exp") for arch in architectures)
+
+
+def collect_warmup_config(worker: "Worker") -> tuple[Qwen4ExpWarmupConfig, Any] | None:
+    """Read the plan's inputs off the loaded model; ``None`` if unavailable."""
+    import torch
+
+    layers = _find_qsa_layers(worker)
+    if not layers:
+        logger.info("Skipping Qwen4Exp JIT warmup: no QSA attention layer found.")
+        return None
+    layer = layers[0]
+
+    indexer = getattr(layer, "indexer", None) or getattr(layer, "qsa_indexer", None)
+    if indexer is None:
+        for attr in vars(layer).values():
+            if type(attr).__name__ == "QSAIndexer":
+                indexer = attr
+                break
+    if indexer is None:
+        logger.info("Skipping Qwen4Exp JIT warmup: QSA indexer not reachable.")
+        return None
+
+    kv_cache = getattr(layer, "kv_cache", None)
+    if isinstance(kv_cache, (list, tuple)):
+        kv_cache = kv_cache[0] if kv_cache else None
+    if not isinstance(kv_cache, torch.Tensor) or kv_cache.numel() == 0:
+        logger.info("Skipping Qwen4Exp JIT warmup: QSA KV cache is not bound.")
+        return None
+
+    compressed = getattr(indexer, "compressed_key_cache", None)
+    compressed_cache = getattr(compressed, "kv_cache", None)
+    if not isinstance(compressed_cache, torch.Tensor) or compressed_cache.numel() == 0:
+        logger.info("Skipping Qwen4Exp JIT warmup: compressed KV cache is not bound.")
+        return None
+
+    model_config = worker.vllm_config.model_config
+    scheduler_config = worker.vllm_config.scheduler_config
+    cache_config = worker.vllm_config.cache_config
+    spec_config = worker.vllm_config.speculative_config
+
+    block_size = int(cache_config.block_size)
+    max_model_len = int(model_config.max_model_len)
+    compress_ratio = int(indexer.compress_ratio)
+    compressed_page_size = int(compressed_cache.shape[1])
+
+    # PAGE_TABLE_WIDTH is a constexpr, so it must be the width the served
+    # kernels actually see. Read it off the allocated block tables and only
+    # fall back to deriving it if the runner does not expose them.
+    widths = _block_table_widths(worker)
+    kv_page_table_width = widths.get(
+        getattr(layer, "layer_name", None), _cdiv(max_model_len, block_size)
+    )
+    compressed_page_table_width = widths.get(
+        getattr(compressed, "prefix", None),
+        _cdiv(_cdiv(max_model_len, compress_ratio), compressed_page_size),
+    )
+
+    num_speculative_tokens = 0
+    draft_sample_method = None
+    rejection_sample_method = None
+    if spec_config is not None:
+        num_speculative_tokens = int(spec_config.num_speculative_tokens or 0)
+        draft_sample_method = getattr(spec_config, "draft_sample_method", None)
+        rejection_sample_method = getattr(spec_config, "rejection_sample_method", None)
+
+    cfg = Qwen4ExpWarmupConfig(
+        num_query_heads=int(layer.num_heads),
+        num_kv_heads=int(layer.num_kv_heads),
+        head_dim=int(layer.head_dim),
+        kv_page_size=block_size,
+        kv_page_table_width=kv_page_table_width,
+        num_kv_pages=int(kv_cache.shape[0]),
+        kv_dtype=_dtype_name(kv_cache.dtype),
+        index_n_heads=int(indexer.index_n_heads),
+        index_head_dim=int(indexer.index_head_dim),
+        compress_ratio=compress_ratio,
+        token_topk=int(indexer.token_topk),
+        compressed_page_size=compressed_page_size,
+        compressed_page_table_width=compressed_page_table_width,
+        num_compressed_pages=int(compressed_cache.shape[0]),
+        max_num_seqs=int(scheduler_config.max_num_seqs),
+        max_num_batched_tokens=int(scheduler_config.max_num_batched_tokens),
+        num_speculative_tokens=num_speculative_tokens,
+        vocab_size=int(model_config.get_vocab_size()),
+        logits_dtype=_dtype_name(model_config.head_dtype),
+        use_fp64_gumbel=bool(model_config.use_fp64_gumbel),
+        has_draft_logits=draft_sample_method == "probabilistic",
+        use_block_verification=rejection_sample_method == "block",
+        use_synthetic_rates=rejection_sample_method == "synthetic",
+    )
+    return cfg, (layer, indexer, kv_cache, compressed_cache)
+
+
+# ---------------------------------------------------------------------------
+# Driver
+# ---------------------------------------------------------------------------
+
+
+def _split_qsa_kv_cache(layer: Any, kv_cache: "torch.Tensor"):
+    """Reproduce the K/V views `Qwen4ExpQSAFlashAttentionImpl` passes down."""
+    from vllm.utils.torch_utils import canonicalize_singleton_dim_strides
+
+    head_size = int(layer.head_dim)
+    key_cache, value_cache = kv_cache.transpose(1, 2).split(head_size, dim=-1)
+    return (
+        canonicalize_singleton_dim_strides(key_cache),
+        canonicalize_singleton_dim_strides(value_cache),
+    )
+
+
+def build_qsa_mqa_inputs(
+    cfg: Qwen4ExpWarmupConfig,
+    compressed_cache: "torch.Tensor",
+    dispatch: QsaDispatch,
+) -> dict[str, Any]:
+    """Arguments for one `qsa_mqa_paged` warmup launch.
+
+    `token_to_req` is ``-1`` so the kernel resolves ``visible = 0`` and returns
+    before its first cache load; the page table is ``-1`` so no page would be
+    dereferenced even if it did not.
+    """
+    import torch
+
+    device = compressed_cache.device
+    rows, num_reqs = dispatch.rows, dispatch.num_reqs
+    return dict(
+        q=torch.zeros(
+            (rows, cfg.index_n_heads, cfg.index_head_dim),
+            dtype=compressed_cache.dtype,
+            device=device,
+        ),
+        k_cache=compressed_cache,
+        page_table=torch.full(
+            (num_reqs, cfg.compressed_page_table_width),
+            -1,
+            dtype=torch.int32,
+            device=device,
+        ),
+        token_to_req=torch.full((rows,), -1, dtype=torch.int32, device=device),
+        # QSAMetadataBuilder.logical_positions_buffer is int64; a narrower
+        # dtype here would compile a binary serving never uses.
+        query_positions=torch.zeros(rows, dtype=torch.int64, device=device),
+        sequence_lengths=torch.zeros(num_reqs, dtype=torch.int32, device=device),
+        compress_ratio=cfg.compress_ratio,
+    )
+
+
+def build_qsa_sparse_inputs(
+    cfg: Qwen4ExpWarmupConfig,
+    key_cache: "torch.Tensor",
+    value_cache: "torch.Tensor",
+    dispatch: QsaDispatch,
+) -> dict[str, Any]:
+    """Arguments for one `qsa_sparse_paged_attention` warmup launch.
+
+    Both the selected token indices and the request ids are ``-1``, which makes
+    the split-k kernel's `valid` predicate false for every column, so every K/V
+    load is masked off.
+    """
+    import torch
+
+    device = key_cache.device
+    rows, num_reqs = dispatch.rows, dispatch.num_reqs
+    q = torch.zeros(
+        (rows, cfg.num_query_heads, cfg.head_dim),
+        dtype=key_cache.dtype,
+        device=device,
+    )
+    return dict(
+        q=q,
+        k_cache=key_cache,
+        v_cache=value_cache,
+        logical_indices=torch.full(
+            (rows, cfg.selection_width), -1, dtype=torch.int32, device=device
+        ),
+        block_table=torch.full(
+            (num_reqs, cfg.kv_page_table_width), -1, dtype=torch.int32, device=device
+        ),
+        token_to_req=torch.full((rows,), -1, dtype=torch.int32, device=device),
+        out=torch.zeros_like(q),
+    )
+
+
+def _run_qsa_mqa(
+    cfg: Qwen4ExpWarmupConfig,
+    compressed_cache: "torch.Tensor",
+    dispatch: QsaDispatch,
+) -> None:
+    from vllm.models.qwen4_exp.nvidia.ops.qsa import qsa_mqa_paged
+
+    args = build_qsa_mqa_inputs(cfg, compressed_cache, dispatch)
+    qsa_mqa_paged(
+        args["q"],
+        args["k_cache"],
+        args["page_table"],
+        args["token_to_req"],
+        args["query_positions"],
+        args["sequence_lengths"],
+        args["compress_ratio"],
+    )
+
+
+def _run_qsa_sparse(
+    cfg: Qwen4ExpWarmupConfig,
+    layer: Any,
+    kv_cache: "torch.Tensor",
+    dispatch: QsaDispatch,
+) -> None:
+    from vllm.models.qwen4_exp.nvidia.ops.qsa import qsa_sparse_paged_attention
+
+    key_cache, value_cache = _split_qsa_kv_cache(layer, kv_cache)
+    args = build_qsa_sparse_inputs(cfg, key_cache, value_cache, dispatch)
+    qsa_sparse_paged_attention(
+        args["q"],
+        args["k_cache"],
+        args["v_cache"],
+        args["logical_indices"],
+        args["block_table"],
+        args["token_to_req"],
+        args["out"],
+    )
+
+
+def _run_gumbel(
+    cfg: Qwen4ExpWarmupConfig, worker: "Worker", dispatch: GumbelDispatch
+) -> None:
+    import torch
+
+    from vllm.v1.worker.gpu.sample.gumbel import gumbel_sample
+
+    device = worker.device
+    logits_dtype = getattr(torch, cfg.logits_dtype)
+    num_tokens = 2
+    logits = torch.zeros(
+        (num_tokens, cfg.vocab_size), dtype=logits_dtype, device=device
+    )
+    idx_mapping = torch.zeros(num_tokens, dtype=torch.int64, device=device)
+    temperature = torch.ones(cfg.max_num_seqs, dtype=torch.float32, device=device)
+    seeds = torch.zeros(cfg.max_num_seqs, dtype=torch.int64, device=device)
+    pos = torch.zeros(num_tokens, dtype=torch.int64, device=device)
+
+    logits_cache = None
+    logits_cache_col = None
+    if dispatch.has_logits_cache:
+        steps = max(1, cfg.num_speculative_tokens)
+        logits_cache = torch.zeros(
+            (cfg.max_num_seqs, steps, cfg.vocab_size),
+            dtype=logits_dtype,
+            device=device,
+        )
+        if dispatch.per_token_col:
+            logits_cache_col = torch.zeros(
+                num_tokens, dtype=torch.int32, device=device
+            )
+        else:
+            logits_cache_col = torch.zeros((), dtype=torch.int32, device=device)
+
+    gumbel_sample(
+        logits,
+        idx_mapping,
+        temperature,
+        seeds,
+        pos,
+        apply_temperature=dispatch.apply_temperature,
+        logits_cache=logits_cache,
+        logits_cache_col=logits_cache_col,
+        use_fp64=cfg.use_fp64_gumbel,
+    )
+
+
+def _run_rejection(cfg: Qwen4ExpWarmupConfig, worker: "Worker") -> None:
+    import torch
+
+    from vllm.v1.worker.gpu.spec_decode.rejection_sampler_utils import (
+        rejection_sample,
+    )
+
+    device = worker.device
+    logits_dtype = getattr(torch, cfg.logits_dtype)
+    steps = cfg.num_speculative_tokens
+    num_reqs = 1
+    num_logits = num_reqs * (steps + 1)
+
+    target_logits = torch.zeros(
+        (num_logits, cfg.vocab_size), dtype=logits_dtype, device=device
+    )
+    draft_logits = None
+    if cfg.has_draft_logits:
+        draft_logits = torch.zeros(
+            (cfg.max_num_seqs, steps, cfg.vocab_size),
+            dtype=logits_dtype,
+            device=device,
+        )
+    draft_sampled = torch.zeros(num_logits, dtype=torch.int64, device=device)
+    cu_num_logits = torch.tensor(
+        [0, num_logits], dtype=torch.int32, device=device
+    )
+    pos = torch.zeros(num_logits, dtype=torch.int64, device=device)
+    idx_mapping = torch.zeros(num_reqs, dtype=torch.int64, device=device)
+    expanded_idx_mapping = torch.zeros(num_logits, dtype=torch.int64, device=device)
+    expanded_local_pos = torch.arange(
+        num_logits, dtype=torch.int32, device=device
+    )
+    temperature = torch.ones(cfg.max_num_seqs, dtype=torch.float32, device=device)
+    seeds = torch.zeros(cfg.max_num_seqs, dtype=torch.int64, device=device)
+
+    rejection_sample(
+        target_logits,
+        draft_logits,
+        draft_sampled,
+        cu_num_logits,
+        pos,
+        idx_mapping,
+        expanded_idx_mapping,
+        expanded_local_pos,
+        temperature,
+        seeds,
+        steps,
+        None,
+        use_fp64=cfg.use_fp64_gumbel,
+        use_block_verification=cfg.use_block_verification,
+    )
+
+
+def qwen4_exp_jit_warmup(worker: "Worker") -> WarmupPlan | None:
+    """Compile every Qwen4Exp Triton specialisation serving can reach.
+
+    Returns the executed plan, or ``None`` when the model is not Qwen4Exp or
+    the caches are not bound yet.  Never raises: a failure here degrades to
+    today's behaviour (a JIT stall on the first request that needs the shape),
+    which is strictly better than failing the boot.
+    """
+    import torch
+
+    if not is_qwen4_exp(worker):
+        return None
+
+    try:
+        collected = collect_warmup_config(worker)
+    except Exception:
+        logger.warning(
+            "Skipping Qwen4Exp JIT warmup: config collection failed.",
+            exc_info=True,
+        )
+        return None
+    if collected is None:
+        return None
+    cfg, (layer, _indexer, kv_cache, compressed_cache) = collected
+
+    plan = build_warmup_plan(cfg)
+    launches = plan.launches()
+    logger.info(
+        "Warming %d Qwen4Exp Triton specialisations across %d kernels "
+        "with %d launches.",
+        len(plan.entries),
+        len(plan.kernels()),
+        len(launches),
+    )
+
+    failures: dict[str, str] = {}
+    with torch.inference_mode():
+        for driver, dispatch in launches:
+            try:
+                if driver == "qsa_mqa":
+                    _run_qsa_mqa(cfg, compressed_cache, dispatch)
+                elif driver == "qsa_sparse":
+                    _run_qsa_sparse(cfg, layer, kv_cache, dispatch)
+                elif driver == "gumbel":
+                    _run_gumbel(cfg, worker, dispatch)
+                elif driver == "rejection":
+                    _run_rejection(cfg, worker)
+            except Exception as exc:  # pragma: no cover - GPU-only path
+                failures.setdefault(driver, f"{type(exc).__name__}: {exc}")
+        if kv_cache.is_cuda:
+            torch.accelerator.synchronize(kv_cache.device)
+
+    if failures:
+        logger.warning(
+            "Qwen4Exp JIT warmup could not compile every specialisation; "
+            "affected drivers: %s. The first request needing a missing shape "
+            "will still JIT.",
+            failures,
+        )
+    else:
+        logger.info("Qwen4Exp JIT warmup complete: %s.", sorted(plan.kernels()))
+    return plan
