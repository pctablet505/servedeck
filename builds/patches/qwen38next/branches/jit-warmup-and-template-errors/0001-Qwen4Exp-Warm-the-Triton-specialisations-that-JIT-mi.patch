+# ---------------------------------------------------------------------------
+# Launch profiles.
+#
+# These are the only inputs that pick a *different* Triton specialisation of
+# the QSA kernels below, so they are factored out as pure functions: the JIT
+# warmup planner (`vllm.model_executor.warmup.qwen4_exp_jit_warmup`) imports
+# them to enumerate the specialisations it must compile before the server
+# reports ready.  Keep them free of tensors and CUDA so the planner and its
+# CPU tests can call them.
+# ---------------------------------------------------------------------------
+
+
+def qsa_mqa_tiles_per_program(rows: int) -> int:
+    """`TILES_PER_PROG` constexpr used by `_qsa_mqa_paged_kernel`."""
+    # Tuned on GB300: larger row batches provide enough parallelism to reuse Q.
+    return 1 if rows <= 32 else 8
+
+
+def qsa_sparse_launch_profile(
+    base_programs: int, block_m: int
+) -> tuple[int, int, int]:
+    """`(BLOCK_N, target_splits, num_warps)` for `_qsa_sparse_paged_gqa_splitk_kernel`.
+
+    `base_programs` is `num_rows * num_kv_heads`; `block_m` is
+    `next_power_of_2(group_size)`.
+    """
+    small_profile_limit = 8 if block_m <= 8 else 4
+
+    # Tuned on GB300 for the Qwen-Air TP1, TP2, and TP4 attention shapes.
+    # Narrow tiles favor decode; wide tiles improve throughput for prefill.
+    if base_programs <= small_profile_limit:
+        return 16, 64, 4
+    if base_programs < 32:
+        return 16, 32, 4
+    if base_programs <= 256:
+        return 64, 8, 2
+    if base_programs <= 512:
+        return 64, 4, 2
+    return 64, 1, 2
+
+
+def qsa_sparse_split_plan(
+    topk: int, block_n: int, target_splits: int
+) -> tuple[int, int]:
+    """`(NUM_TILES, NUM_SPLITS)` constexprs for the split-k QSA kernel."""
+    num_tiles = -(-topk // block_n)
+    # Avoid empty splits when the selection width is smaller than the profile.
+    max_useful_splits = 1 << (num_tiles.bit_length() - 1)
+    return num_tiles, min(max_useful_splits, target_splits)
+
+
+def qsa_mqa_rows_per_chunk(columns: int) -> int:
+    """Row-chunk size `qsa_select_paged_tokens` feeds to `qsa_mqa_paged`."""
+    return max(1, _LOGITS_WORKSPACE_BYTES // max(columns * 4, 1))
