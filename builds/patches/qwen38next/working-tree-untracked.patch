diff --git a/tests/entrypoints/unit_tests/test_postprocess_messages_invalid_arguments.py b/tests/entrypoints/unit_tests/test_postprocess_messages_invalid_arguments.py
new file mode 100644
index 000000000..85beb674d
--- /dev/null
+++ b/tests/entrypoints/unit_tests/test_postprocess_messages_invalid_arguments.py
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""One history ``function_call`` with invalid JSON ``arguments`` must not
+make the whole request fail.
+
+Incident, 2026-10-15 23:20Z: a Codex session on Flash-Next stored a
+``function_call`` item whose ``arguments`` is an unterminated JSON string.
+Codex resends its whole history on every ``POST /v1/responses``, and
+``_postprocess_messages`` ran ``json.loads`` on that string, so every later
+request answered HTTP 400 ``Unterminated string starting at: line 1 column 9
+(char 8)``.  The session could not continue until the history was edited by
+hand.
+
+``/v1/responses`` input reaches ``_postprocess_messages`` through
+``construct_input_messages`` (responses/utils.py) and
+``parse_chat_messages_async`` (chat_utils.py); the tests run those two real
+conversion steps on CPU.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+from openai.types.responses import ResponseFunctionToolCall
+
+from vllm.entrypoints.chat_utils import _postprocess_messages
+from vllm.entrypoints.openai.responses.utils import construct_input_messages
+
+# arguments of the call that ended the stream inside ``cmd`` (shortened).
+_TRUNCATED = (
+    '{"cmd": "cd ~/Projects/x && cat >> RUNLOG.md <<\'EOF\'\\nnote\\n</think>'
+    "\\n\\n<tool_call>\\n<function=exec_command>"
+)
+
+
+def _history(arguments: str) -> list:
+    return [
+        {"type": "message", "role": "user", "content": "go"},
+        ResponseFunctionToolCall(
+            id="fc_1",
+            call_id="call_1",
+            type="function_call",
+            name="exec_command",
+            arguments=arguments,
+        ),
+        {"type": "function_call_output", "call_id": "call_1", "output": "ran"},
+        {"type": "message", "role": "user", "content": "continue"},
+    ]
+
+
+def _convert(arguments: str) -> list:
+    messages = construct_input_messages(request_input=_history(arguments))
+    _postprocess_messages(messages)
+    return messages
+
+
+def _tool_call_arguments(messages: list):
+    (assistant,) = [m for m in messages if m["role"] == "assistant"]
+    (tool_call,) = assistant["tool_calls"]
+    return tool_call["function"]["arguments"]
+
+
+def test_truncated_arguments_are_not_valid_json():
+    # The input really is what the incident sent: the guard for the tests below.
+    with pytest.raises(json.JSONDecodeError, match="Unterminated string"):
+        json.loads(_TRUNCATED)
+
+
+def test_invalid_json_arguments_do_not_fail_the_request():
+    messages = _convert(_TRUNCATED)
+    assert _tool_call_arguments(messages) == {}
+    assert [m["role"] for m in messages] == ["user", "assistant", "tool", "user"]
+
+
+@pytest.mark.parametrize("arguments", ["{", '{"a": ', "not json", '{"a": "b'])
+def test_other_invalid_json_arguments_become_empty_object(arguments):
+    assert _tool_call_arguments(_convert(arguments)) == {}
+
+
+def test_valid_json_arguments_are_still_parsed():
+    assert _tool_call_arguments(_convert('{"cmd": "ls", "n": 3}')) == {
+        "cmd": "ls",
+        "n": 3,
+    }
+
+
+@pytest.mark.parametrize("arguments", ["", "null"])
+def test_empty_arguments_still_become_empty_object(arguments):
+    assert _tool_call_arguments(_convert(arguments)) == {}
diff --git a/tests/entrypoints/unit_tests/test_reasoning_field_chat_template_roundtrip.py b/tests/entrypoints/unit_tests/test_reasoning_field_chat_template_roundtrip.py
new file mode 100644
index 000000000..9cfeb71ea
--- /dev/null
+++ b/tests/entrypoints/unit_tests/test_reasoning_field_chat_template_roundtrip.py
@@ -0,0 +1,104 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""T1 (2026-09-09 investigation): does the chat template still see
+reasoning on re-sent assistant turns?
+
+``ChatCompletionRequest`` normalizes an incoming ``reasoning_content`` key
+to ``reasoning`` (protocol.py's ``_normalize_messages_before``), so
+downstream serving code only has to check one field. Qwen3.8-Flash-Next's
+own ``chat_template.jinja`` (mazinb/Qwen3.8-Flash-Next-Uncensored-NVFP4
+snapshot) was written against the legacy variable name and reads
+``message.reasoning_content is string`` when deciding whether to render a
+``<think>...</think>`` block for a prior assistant turn. If nothing
+restored ``reasoning_content`` after the rename, every re-sent assistant
+turn would render an empty think block -- the same erasure class that
+caused GLM's multi-turn amnesia (see the ``glm53-erased-reasoning-is-the-
+root-cause`` memory note).
+
+``_parse_chat_message_content`` (vllm/entrypoints/chat_utils.py) is where
+that restoration happens: it reads ``message.get("reasoning")`` and, if
+present, sets BOTH ``reasoning`` and ``reasoning_content`` on the
+``ConversationMessage`` dict handed to the Jinja renderer. This test locks
+that in -- it was previously unverified by any test in this tree.
+"""
+
+from unittest.mock import MagicMock
+
+from vllm.entrypoints.chat_utils import _parse_chat_message_content
+
+
+def _mock_tracker() -> MagicMock:
+    """A multimodal item tracker stand-in for a plain-text-only message.
+
+    ``_parse_chat_message_content_parts`` only touches
+    ``mm_parser.model_config.enable_prompt_embeds`` (must be falsy for a
+    plain string part) and ``mm_parser.mm_placeholder_storage()`` (must be
+    falsy so the plain "\n".join(texts) path is taken instead of the
+    multimodal-placeholder path) for text-only content.
+    """
+    tracker = MagicMock()
+    parser = tracker.create_parser.return_value
+    parser.model_config.enable_prompt_embeds = False
+    parser.mm_placeholder_storage.return_value = {}
+    return tracker
+
+
+def test_reasoning_field_restored_as_reasoning_content_for_template():
+    message = {
+        "role": "assistant",
+        "content": "4",
+        # As left by ChatCompletionRequest._normalize_messages_before:
+        # reasoning_content has already been renamed to reasoning by the
+        # time a message dict reaches this function.
+        "reasoning": "2+2 equals 4",
+    }
+
+    result = _parse_chat_message_content(
+        message,
+        _mock_tracker(),
+        content_format="string",
+        interleave_strings=False,
+    )
+
+    assert len(result) == 1
+    conv_msg = result[0]
+    assert conv_msg.get("reasoning") == "2+2 equals 4"
+    assert conv_msg.get("reasoning_content") == "2+2 equals 4", (
+        "chat_template.jinja reads message.reasoning_content; if this is "
+        "missing, reasoning is silently dropped from re-sent assistant "
+        "turns for any template (e.g. Qwen3.8-Flash-Next's) written "
+        "against the legacy field name."
+    )
+
+
+def test_no_reasoning_field_leaves_reasoning_content_absent():
+    message = {"role": "assistant", "content": "Hi"}
+
+    result = _parse_chat_message_content(
+        message,
+        _mock_tracker(),
+        content_format="string",
+        interleave_strings=False,
+    )
+
+    conv_msg = result[0]
+    assert "reasoning" not in conv_msg
+    assert "reasoning_content" not in conv_msg
+
+
+def test_non_assistant_role_does_not_get_reasoning_content():
+    """Only assistant turns get the reasoning_content restoration --
+    matches chat_template.jinja, which only reads it for message.role ==
+    "assistant"."""
+    message = {"role": "user", "content": "Hi", "reasoning": "should be ignored"}
+
+    result = _parse_chat_message_content(
+        message,
+        _mock_tracker(),
+        content_format="string",
+        interleave_strings=False,
+    )
+
+    conv_msg = result[0]
+    assert "reasoning" not in conv_msg
+    assert "reasoning_content" not in conv_msg
diff --git a/tests/models/qwen4_exp/test_qsa_update_draft_decode_metadata.py b/tests/models/qwen4_exp/test_qsa_update_draft_decode_metadata.py
new file mode 100644
index 000000000..7817d10dc
--- /dev/null
+++ b/tests/models/qwen4_exp/test_qsa_update_draft_decode_metadata.py
@@ -0,0 +1,401 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""T3 (2026-09-09 investigation): fused multi-step draft decode for QSA.
+
+``QSAMetadataBuilder`` previously had no ``update_draft_decode_metadata()``
+override (base class default: ``supports_draft_decode_metadata_update =
+False``, method raises ``NotImplementedError``), so the speculator's fused
+multi-step draft decode fast path always fell back to rebuilding attention
+metadata between every draft step -- the exact log line this investigation
+started from: "Fused multi-step draft decode is not supported by attention
+backend(s) QWEN4_EXP_EXP_QSA_STATE; falling back to rebuilding attention
+metadata between draft steps."
+
+These tests lock in that the new implementation produces metadata
+bit-identical to a from-scratch rebuild for one more decode step, for both
+QSA cache shapes served by ``QSAMetadataBuilder``:
+  * the raw-key ring (``CircularBufferSpec``, one physical block per
+    request, positions wrap via ``circular_qsa_slot_mapping``)
+  * the compressed-key cache (``MLAAttentionSpec`` with
+    ``compress_ratio > 1``, boundary-only slots via
+    ``compressed_qsa_slot_mapping`` plus the per-request ``k_work_metadata``
+    work-item list)
+
+CPU-only: ``build_qsa_metadata`` resolves to
+``build_qsa_metadata_triton`` whenever Triton is *importable*
+(``HAS_TRITON``), regardless of whether a GPU is present to actually launch
+the kernel -- true in this venv, so ``build()`` itself cannot run
+unmodified on CPU. Every test here monkeypatches the module-level
+``build_qsa_metadata`` binding to the pure-torch
+``_build_qsa_metadata_torch`` fallback (the same function real CPU-only
+dev boxes without Triton installed take) so ``build()`` (used both for the
+initial state and as the from-scratch-rebuild oracle) runs on plain CPU
+tensors. ``update_draft_decode_metadata`` itself needed no such patch: it
+is pure torch already (``_logical_positions``, ``circular_qsa_slot_mapping``,
+``compressed_qsa_slot_mapping`` have no Triton dependency).
+
+GPU-gated / NOT verified here: CUDA graph capture-and-replay semantics
+(the base class docstring warns implementations must keep replayed state in
+persistent storage) and whether the real speculator loop truly advances
+``seq_lens``/``block_table`` in place before calling this method (traced
+from source -- v1/worker/gpu/spec_decode/autoregressive/speculator.py's
+Triton kernels increment ``input_buffers.seq_lens`` in place -- but not
+executed on hardware).
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import vllm.models.qwen4_exp.common.qsa_cache as qsa_cache_module
+from vllm.models.qwen4_exp.common.qsa_cache import QSAMetadataBuilder
+from vllm.v1.attention.backend import CommonAttentionMetadata
+from vllm.v1.kv_cache_interface import CircularBufferSpec, MLAAttentionSpec
+
+
+@pytest.fixture(autouse=True)
+def _force_torch_qsa_metadata_path(monkeypatch: pytest.MonkeyPatch) -> None:
+    """build() picks build_qsa_metadata_triton whenever Triton is
+    importable, regardless of whether a GPU can actually launch it -- true
+    in this venv. Force the pure-torch fallback so build() runs on CPU
+    tensors; this is the same function real Triton-less CPU boxes use."""
+    monkeypatch.setattr(
+        qsa_cache_module,
+        "build_qsa_metadata",
+        qsa_cache_module._build_qsa_metadata_torch,
+    )
+
+
+def _vllm_config(max_num_batched_tokens: int = 16, max_num_seqs: int = 8):
+    return SimpleNamespace(
+        scheduler_config=SimpleNamespace(
+            max_num_batched_tokens=max_num_batched_tokens,
+            max_num_seqs=max_num_seqs,
+        )
+    )
+
+
+def _decode_common_metadata(
+    *,
+    seq_lens: list[int],
+    block_table: torch.Tensor,
+    slot_mapping: torch.Tensor | None = None,
+) -> CommonAttentionMetadata:
+    """One query token per request (pure decode -- what a draft step is)."""
+    num_reqs = len(seq_lens)
+    query_start_loc = torch.arange(num_reqs + 1, dtype=torch.int32)
+    if slot_mapping is None:
+        slot_mapping = torch.zeros(num_reqs, dtype=torch.int64)
+    return CommonAttentionMetadata(
+        query_start_loc=query_start_loc,
+        query_start_loc_cpu=query_start_loc,
+        seq_lens=torch.tensor(seq_lens, dtype=torch.int32),
+        num_reqs=num_reqs,
+        num_actual_tokens=num_reqs,
+        max_query_len=1,
+        max_seq_len=max(seq_lens),
+        block_table_tensor=block_table,
+        slot_mapping=slot_mapping,
+    )
+
+
+def _padded_decode_common_metadata(
+    *,
+    seq_lens_real: list[int],
+    num_rows_padded: int,
+    block_table: torch.Tensor,
+) -> CommonAttentionMetadata:
+    """CUDA-graph-padded decode batch: ``len(seq_lens_real)`` real one-token
+    decode requests followed by ``num_rows_padded - len(seq_lens_real)``
+    zero-query-length padding rows, matching what
+    ``_build_draft_attn_metadata`` hands the speculator (num_actual_tokens ==
+    num_tokens_padded) and what ``token_to_req_indices`` does with the tail
+    (query length 0 -> drops out of the repeat -> token_to_req 0).
+
+    Real rows get a valid (>= 0) raw slot_mapping entry; padded rows get -1,
+    mirroring production (a CircularBufferSpec group's raw slot_mapping is
+    disabled/always -1 -- see model_runner.py -- while an MLAAttentionSpec
+    group's raw slot_mapping is the real per-token main-KV-cache slot, valid
+    for real rows and -1 for padding).
+    """
+    n = len(seq_lens_real)
+    assert num_rows_padded >= n
+    query_start_loc = torch.clamp(
+        torch.arange(num_rows_padded + 1, dtype=torch.int32), max=n
+    )
+    seq_lens = torch.zeros(num_rows_padded, dtype=torch.int32)
+    seq_lens[:n] = torch.tensor(seq_lens_real, dtype=torch.int32)
+    slot_mapping = torch.full((num_rows_padded,), -1, dtype=torch.int64)
+    slot_mapping[:n] = 0
+    return CommonAttentionMetadata(
+        query_start_loc=query_start_loc,
+        query_start_loc_cpu=query_start_loc,
+        seq_lens=seq_lens,
+        num_reqs=num_rows_padded,
+        num_actual_tokens=num_rows_padded,
+        max_query_len=1,
+        max_seq_len=int(seq_lens.max()),
+        block_table_tensor=block_table,
+        slot_mapping=slot_mapping,
+    )
+
+
+def _assert_padded_update_matches_oracle(
+    builder_factory,
+    *,
+    block_table: torch.Tensor,
+    seq_lens_real: list[int],
+    num_rows_padded: int,
+    num_draft_steps: int = 2,
+) -> None:
+    """Drive ``num_draft_steps`` fused draft-decode updates on a
+    CUDA-graph-padded batch (``len(seq_lens_real)`` real rows padded out to
+    ``num_rows_padded`` total rows) and, after every step, assert the result
+    is bit-identical to an independent from-scratch ``build()`` at the same
+    advanced ``seq_lens`` with the same padding -- and that every padded
+    row's slot and logical position stay -1.
+    """
+    n = len(seq_lens_real)
+    builder = builder_factory()
+    step0 = _padded_decode_common_metadata(
+        seq_lens_real=seq_lens_real,
+        num_rows_padded=num_rows_padded,
+        block_table=block_table,
+    )
+    metadata = builder.build(common_prefix_len=0, common_attn_metadata=step0)
+    slot_mapping_ptr = metadata.slot_mapping.data_ptr()
+    logical_positions_ptr = metadata.logical_positions.data_ptr()
+    k_work_ptr = (
+        metadata.k_work_metadata.data_ptr()
+        if metadata.k_work_metadata.numel() > 0
+        else None
+    )
+
+    cur_seq_lens = list(seq_lens_real)
+    for step in range(1, num_draft_steps + 1):
+        metadata.seq_lens[:n] += 1
+        cur_seq_lens = [s + 1 for s in cur_seq_lens]
+        builder.update_draft_decode_metadata(metadata)
+
+        # Buffers must never be reallocated -- CUDA graph replay re-runs only
+        # the captured kernels, not this Python method.
+        assert metadata.slot_mapping.data_ptr() == slot_mapping_ptr, step
+        assert metadata.logical_positions.data_ptr() == logical_positions_ptr, step
+        if k_work_ptr is not None:
+            assert metadata.k_work_metadata.data_ptr() == k_work_ptr, step
+
+        oracle_builder = builder_factory()
+        oracle_step = _padded_decode_common_metadata(
+            seq_lens_real=cur_seq_lens,
+            num_rows_padded=num_rows_padded,
+            block_table=block_table,
+        )
+        oracle = oracle_builder.build(
+            common_prefix_len=0, common_attn_metadata=oracle_step
+        )
+
+        assert torch.equal(metadata.slot_mapping, oracle.slot_mapping), step
+        assert torch.equal(
+            metadata.logical_positions, oracle.logical_positions
+        ), step
+        assert torch.equal(metadata.k_work_metadata, oracle.k_work_metadata), step
+
+        if n < num_rows_padded:
+            assert torch.all(metadata.slot_mapping[n:] == -1), step
+            assert torch.all(metadata.logical_positions[n:] == -1), step
+
+
+class TestCircularBufferRing:
+    """QSA raw-key ring: one physical block per request, ring capacity =
+    ``block_size`` (8 here, matching the shipped span=compress_ratio(4) +
+    num_speculative_tokens(3) -> capacity 8 at spec=3)."""
+
+    def _spec(self) -> CircularBufferSpec:
+        return CircularBufferSpec(
+            block_size=8, num_kv_heads=1, head_size=16, dtype=torch.bfloat16
+        )
+
+    def _builder(self) -> QSAMetadataBuilder:
+        return QSAMetadataBuilder(
+            self._spec(), ["layer.0"], _vllm_config(), torch.device("cpu")
+        )
+
+    def test_supports_fused_decode(self):
+        assert self._builder().supports_draft_decode_metadata_update is True
+
+    def test_update_matches_from_scratch_rebuild(self):
+        builder = self._builder()
+        block_table = torch.tensor([[5], [9]], dtype=torch.int32)  # 2 requests
+
+        step1 = _decode_common_metadata(seq_lens=[20, 35], block_table=block_table)
+        metadata = builder.build(common_prefix_len=0, common_attn_metadata=step1)
+        step1_slot_mapping = metadata.slot_mapping.clone()
+        step1_logical_positions = metadata.logical_positions.clone()
+
+        # Simulate the speculator's persistent-buffer advance: seq_lens is
+        # the same tensor object build() aliased from common_attn_metadata,
+        # mutated in place -- as the real draft loop's Triton kernel does
+        # (speculator.py, "Increment position and seq_lens").
+        metadata.seq_lens += 1
+        builder.update_draft_decode_metadata(metadata)
+
+        # Oracle: an independent builder, rebuilt from scratch for the
+        # already-advanced (step 2) state.
+        oracle_builder = self._builder()
+        step2 = _decode_common_metadata(seq_lens=[21, 36], block_table=block_table)
+        oracle = oracle_builder.build(common_prefix_len=0, common_attn_metadata=step2)
+
+        assert torch.equal(metadata.slot_mapping, oracle.slot_mapping)
+        assert torch.equal(metadata.logical_positions, oracle.logical_positions)
+        # And it actually advanced -- guards against a silent no-op.
+        assert not torch.equal(metadata.slot_mapping, step1_slot_mapping)
+        assert not torch.equal(metadata.logical_positions, step1_logical_positions)
+
+    def test_update_is_in_place_not_a_new_tensor(self):
+        """CUDA graph replay does not re-run this Python method, so the
+        writes it records during capture must land in the same buffers
+        build() allocated -- a reassignment would silently stop updating
+        once replayed."""
+        builder = self._builder()
+        block_table = torch.tensor([[5], [9]], dtype=torch.int32)
+        step1 = _decode_common_metadata(seq_lens=[20, 35], block_table=block_table)
+        metadata = builder.build(common_prefix_len=0, common_attn_metadata=step1)
+        slot_mapping_storage = metadata.slot_mapping.data_ptr()
+        logical_positions_storage = metadata.logical_positions.data_ptr()
+
+        metadata.seq_lens += 1
+        builder.update_draft_decode_metadata(metadata)
+
+        assert metadata.slot_mapping.data_ptr() == slot_mapping_storage
+        assert metadata.logical_positions.data_ptr() == logical_positions_storage
+
+    def test_update_matches_oracle_2_real_padded_to_8(self):
+        """CUDA-graph batch padding: 2 real requests, batch padded to 8 rows
+        (this is the reviewer's repro shape: ring blocks 5 and 9,
+        block_size 8). Without the fix, padded rows alias onto request 0's
+        raw-key ring instead of staying at PAD_SLOT_ID."""
+        _assert_padded_update_matches_oracle(
+            self._builder,
+            block_table=torch.tensor([[5], [9]], dtype=torch.int32),
+            seq_lens_real=[20, 35],
+            num_rows_padded=8,
+        )
+
+    def test_update_matches_oracle_3_real_padded_to_4(self):
+        """A second padding ratio/request-count combination (3 real rows,
+        1 padding row) so the fix is not just verified at the 2-of-8 shape."""
+        _assert_padded_update_matches_oracle(
+            self._builder,
+            block_table=torch.tensor([[2], [5], [9]], dtype=torch.int32),
+            seq_lens_real=[12, 20, 35],
+            num_rows_padded=4,
+        )
+
+
+class TestCompressedKeyCache:
+    """QSA compressed-key cache: boundary-only slots (one write per
+    ``compress_ratio`` committed tokens) plus the ``k_work_metadata`` work
+    list the compression kernel consumes."""
+
+    def _spec(self) -> MLAAttentionSpec:
+        return MLAAttentionSpec(
+            block_size=32,
+            num_kv_heads=1,
+            head_size=64,
+            dtype=torch.bfloat16,
+            compress_ratio=4,
+        )
+
+    def _builder(self) -> QSAMetadataBuilder:
+        return QSAMetadataBuilder(
+            self._spec(), ["layer.0"], _vllm_config(), torch.device("cpu")
+        )
+
+    def test_supports_fused_decode(self):
+        assert self._builder().supports_draft_decode_metadata_update is True
+
+    def test_update_matches_from_scratch_rebuild_across_group_boundary(self):
+        """compress_ratio=4: a slot is only written when logical_position
+        lands on a group boundary ((position + 1) % 4 == 0). Chosen so req0
+        is ON a boundary at step 1 and OFF at step 2, and req1 is the
+        reverse -- exercising both the valid-slot and the -1 (no write this
+        step) cases across the transition.
+        """
+        builder = self._builder()
+        block_table = torch.tensor([[3, 4], [7, 8]], dtype=torch.int32)
+
+        # positions: req0 19 -> 20 (boundary -> not); req1 22 -> 23 (not -> boundary)
+        step1 = _decode_common_metadata(seq_lens=[20, 23], block_table=block_table)
+        metadata = builder.build(common_prefix_len=0, common_attn_metadata=step1)
+        assert metadata.slot_mapping[0].item() != -1  # req0 hits a boundary
+        assert metadata.slot_mapping[1].item() == -1  # req1 does not
+
+        metadata.seq_lens += 1
+        builder.update_draft_decode_metadata(metadata)
+
+        oracle_builder = self._builder()
+        step2 = _decode_common_metadata(seq_lens=[21, 24], block_table=block_table)
+        oracle = oracle_builder.build(common_prefix_len=0, common_attn_metadata=step2)
+
+        assert torch.equal(metadata.slot_mapping, oracle.slot_mapping)
+        assert torch.equal(metadata.logical_positions, oracle.logical_positions)
+        assert torch.equal(metadata.k_work_metadata, oracle.k_work_metadata)
+        assert metadata.slot_mapping[0].item() == -1  # req0 no longer at boundary
+        assert metadata.slot_mapping[1].item() != -1  # req1 now is
+
+    def test_token_valid_mask_survives_the_update(self):
+        """token_valid is captured once at build() time from the scheduler's
+        raw slot_mapping and is NOT recomputed by update_draft_decode_metadata
+        (batch composition -- which rows are real vs. padding -- cannot
+        change mid-draft-loop). A row the scheduler marked invalid at build
+        time must stay masked to -1 even once it reaches a compression
+        boundary on a later draft step."""
+        builder = self._builder()
+        block_table = torch.tensor([[3, 4]], dtype=torch.int32)  # 1 request
+        # Raw scheduler slot_mapping < 0 marks this token invalid (e.g. a
+        # padding row in a CUDA-graph-padded batch).
+        raw_slot_mapping = torch.tensor([-1], dtype=torch.int64)
+
+        step1 = _decode_common_metadata(
+            seq_lens=[19], block_table=block_table, slot_mapping=raw_slot_mapping
+        )
+        metadata = builder.build(common_prefix_len=0, common_attn_metadata=step1)
+        assert metadata.token_valid[0].item() is False
+
+        # Advance straight onto a compression boundary (position 19 -> 22,
+        # (22 + 1) % 4 == 0): the compressed_qsa_slot_mapping math alone
+        # would produce a real slot here.
+        metadata.seq_lens += 3
+        builder.update_draft_decode_metadata(metadata)
+
+        assert metadata.slot_mapping[0].item() == -1, (
+            "a row invalid at build() time must stay masked after "
+            "update_draft_decode_metadata, even at a compression boundary"
+        )
+
+    def test_update_matches_oracle_2_real_padded_to_8(self):
+        """CUDA-graph batch padding on the compressed-key cache: 2 real
+        requests, batch padded to 8 rows. Without the fix, padded rows'
+        logical_positions alias onto request 0's positions and, whenever
+        that aliased position lands on a compression-group boundary,
+        ``compressed_qsa_slot_mapping`` would write a live slot for a
+        padding row instead of leaving it at PAD_SLOT_ID."""
+        _assert_padded_update_matches_oracle(
+            self._builder,
+            block_table=torch.tensor([[3, 4], [7, 8]], dtype=torch.int32),
+            seq_lens_real=[20, 23],
+            num_rows_padded=8,
+        )
+
+    def test_update_matches_oracle_3_real_padded_to_4(self):
+        """A second padding ratio/request-count combination (3 real rows,
+        1 padding row) so the fix is not just verified at the 2-of-8 shape."""
+        _assert_padded_update_matches_oracle(
+            self._builder,
+            block_table=torch.tensor(
+                [[3, 4], [7, 8], [11, 12]], dtype=torch.int32
+            ),
+            seq_lens_real=[20, 23, 17],
+            num_rows_padded=4,
+        )
diff --git a/tests/v1/worker/test_ple_offload_event_race.py b/tests/v1/worker/test_ple_offload_event_race.py
new file mode 100644
index 000000000..e0c616168
--- /dev/null
+++ b/tests/v1/worker/test_ple_offload_event_race.py
@@ -0,0 +1,219 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The PLE request thread must never wait on a batch launched after its own.
+
+With async scheduling the model thread launches batch N+1 while forward N is
+still parked on the CPU worker's result for request N. The request thread
+publishes request N only after N's D2H copies completed. If that completion
+is tracked by state the launch of N+1 also touches, a request thread that
+runs late waits for work queued behind forward N, and forward N waits for the
+request the thread has not published: both wait forever with the GPU idle.
+"""
+
+import contextlib
+import queue
+import threading
+from multiprocessing.reduction import ForkingPickler
+from unittest.mock import Mock
+
+import pytest
+import torch
+import torch.multiprocessing as torch_mp
+
+from vllm.model_executor.layers import ple_offload_layer
+from vllm.model_executor.layers.ple_offload_layer import CpuGpuSemaphore
+from vllm.v1.ple_offload.connector import (
+    PleOffloadConnector,
+    _PendingPleOffloadRequest,
+)
+from vllm.v1.ple_offload.protocol import PleOffloadRequest
+
+
+def test_ple_offload_returns_event_before_publishing_request(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Free the D2H event before the CPU worker can answer the request.
+
+    The model thread launches the batch after next only once this batch has an
+    output, which needs the published request. An event returned after the
+    send could still be out of the pool when that launch asks for one.
+    """
+    monkeypatch.setattr(
+        torch.accelerator, "device_index", lambda _index: contextlib.nullcontext()
+    )
+    monkeypatch.setattr(
+        torch.cuda.nvtx, "range", lambda *_args, **_kwargs: contextlib.nullcontext()
+    )
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    connector.device = torch.device("cuda:0")
+    connector._uses_cuda_inputs = True
+    connector._d2h_event_pool = queue.Queue(maxsize=2)
+    order: list[str] = []
+    event = Mock()
+    event.synchronize.side_effect = lambda: order.append("synchronize")
+    socket = Mock()
+
+    def send(_payload: bytes) -> None:
+        order.append("send")
+        assert connector._d2h_event_pool is not None
+        assert connector._d2h_event_pool.qsize() == 1
+
+    socket.send.side_effect = send
+    pending = _PendingPleOffloadRequest(
+        PleOffloadRequest(dp_rank=0, num_tokens=4, num_reqs=2), event
+    )
+
+    connector._process_request(pending, socket)
+
+    assert order == ["synchronize", "send"]
+    assert connector._d2h_event_pool.get_nowait() is event
+
+
+def test_ple_offload_launch_returns_only_after_the_request_is_published(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Hold the model thread until the request thread has sent the request.
+
+    The forward queued after a launch parks the model stream until the CPU
+    worker answers. A kernel launch that blocks on the parked stream keeps the
+    GIL, so a request still unpublished at that point could never be sent.
+    """
+    monkeypatch.setattr(
+        torch.accelerator, "device_index", lambda _index: contextlib.nullcontext()
+    )
+    monkeypatch.setattr(
+        torch.cuda.nvtx, "range", lambda *_args, **_kwargs: contextlib.nullcontext()
+    )
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    connector.device = torch.device("cuda:0")
+    connector.tp_rank = 0
+    connector.dp_rank = 0
+    connector._uses_cuda_inputs = True
+    connector._request_thread = Mock()
+    connector._request_queue = queue.Queue(maxsize=2)
+    connector._d2h_event_pool = queue.Queue(maxsize=2)
+    connector._d2h_event_pool.put_nowait(Mock())
+    connector._d2h_event_pool.put_nowait(Mock())
+    connector._enqueue_cuda_inputs = Mock()  # type: ignore[method-assign]
+    order: list[str] = []
+    socket = Mock()
+    socket.send.side_effect = lambda _payload: order.append("published")
+    launched = threading.Event()
+
+    def launch() -> None:
+        connector._launch(num_reqs=2, num_tokens=4)
+        order.append("launch returned")
+        launched.set()
+
+    model_thread = threading.Thread(target=launch, daemon=True)
+    model_thread.start()
+    pending = connector._request_queue.get(timeout=5)
+    assert pending is not None
+    assert not launched.wait(timeout=0.2)
+
+    connector._process_request(pending, socket)
+
+    assert launched.wait(timeout=5)
+    model_thread.join(timeout=5)
+    assert order == ["published", "launch returned"]
+
+
+@pytest.mark.skipif(not torch.accelerator.is_available(), reason="GPU is required")
+def test_ple_offload_request_does_not_wait_for_the_next_batch() -> None:
+    """Publish request N while forward N is parked and N+1 is already launched."""
+    socket = Mock()
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    connector.device = torch.device("cuda:0")
+    connector.tp_rank = 0
+    connector.dp_rank = 0
+    original_strategy = torch_mp.get_sharing_strategy()
+    try:
+        torch_mp.set_sharing_strategy("file_descriptor")
+        connector._input_ids_buf = torch.full(
+            (4,), -99, dtype=torch.int32
+        ).share_memory_()
+        connector._query_start_loc_buf = torch.full(
+            (3,), -99, dtype=torch.int32
+        ).share_memory_()
+        connector._ngram_context_buf = None
+        input_buffers = (connector._input_ids_buf, connector._query_start_loc_buf)
+        torch_mp.set_sharing_strategy("file_system")
+        ForkingPickler.dumps(input_buffers)
+    finally:
+        torch_mp.set_sharing_strategy(original_strategy)
+
+    connector._pinned_input_buffers = []
+    connector._request_thread = None
+    connector._request_queue = queue.Queue(maxsize=2)
+    published = threading.Event()
+    publisher: threading.Thread | None = None
+
+    with torch.accelerator.device_index(connector.device.index):
+        connector._input_ids_source = torch.tensor(
+            [7, -1, 11, -1], dtype=torch.int32, device=connector.device
+        )
+        connector._query_start_loc_source = torch.tensor(
+            [0, 2, 4], dtype=torch.int32, device=connector.device
+        )
+        connector._ngram_context_source = None
+        connector._uses_cuda_inputs = True
+        connector._validate_input_sources()
+        connector._pin_input_buffers()
+        connector._d2h_event_pool = queue.Queue(maxsize=2)
+        connector._d2h_event_pool.put_nowait(torch.cuda.Event())
+        connector._d2h_event_pool.put_nowait(torch.cuda.Event())
+        # Everything the test allocates on the GPU exists before the model
+        # stream parks; the model runs on its own stream so the default one
+        # stays free.
+        semaphore = CpuGpuSemaphore(connector.device)
+        placeholder = torch.zeros(1, device=connector.device)
+        model_stream = torch.cuda.Stream(device=connector.device)
+        worker_stream = torch.cuda.Stream(device=connector.device)
+        torch.accelerator.synchronize(connector.device)
+        try:
+            with torch.cuda.stream(model_stream):
+                connector._launch(num_reqs=2, num_tokens=4)
+                # Forward N: the model stream parks until the CPU worker
+                # answers request N.
+                ple_offload_layer._ple_offload_wait_impl(
+                    semaphore.flag_tensor, placeholder, placeholder
+                )
+                # The request thread has taken N but has not run yet.
+                first = connector._request_queue.get_nowait()
+                assert first is not None
+                connector._launch(num_reqs=1, num_tokens=2)
+
+            def publish() -> None:
+                connector._process_request(first, socket)
+                published.set()
+
+            publisher = threading.Thread(target=publish, daemon=True)
+            publisher.start()
+            published_while_parked = published.wait(timeout=10)
+            staged = (
+                connector._input_ids_buf.tolist(),
+                connector._query_start_loc_buf.tolist(),
+            )
+        finally:
+            # What the CPU worker does once it has request N. It also releases
+            # a publisher that wrongly waited for the parked model stream.
+            semaphore.signal(worker_stream)
+            if publisher is not None:
+                publisher.join(timeout=30)
+            model_stream.synchronize()
+            torch.accelerator.synchronize(connector.device)
+            connector._unpin_input_buffers()
+
+    assert published_while_parked, (
+        "request N waited for work queued behind forward N: its D2H event "
+        "was shared with the launch of batch N+1"
+    )
+    assert staged == ([7, -1, 11, -1], [0, 2, 4])
+    socket.send.assert_called_once()
+    assert connector._d2h_event_pool.qsize() == 1
+
+    second = connector._request_queue.get_nowait()
+    assert second is not None
+    connector._process_request(second, socket)
+    assert socket.send.call_count == 2
+    assert connector._d2h_event_pool.qsize() == 2
