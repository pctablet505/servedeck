+def test_prefix_match_unit_qwen4exp_qsa_shipped_config():
+    """T2 (2026-09-09 investigation): legal ``--prefix-match-unit`` values
+    for the shipped Qwen3.8-Flash-Next config (MTP spec 3,
+    ``--mamba-ssm-cache-dtype bfloat16``), and confirmation that today's
+    no-override behavior already collapses to the full attention block.
+
+    The shipped config drives the attention block size to 832 tokens (boot
+    log: platforms/interface.py's "Setting attention block size to N
+    tokens..." logs 1600 without ``--mamba-ssm-cache-dtype bfloat16``; 832
+    is the previously-measured bf16 value -- see the
+    ``qwen-flashnext-perf-ceiling`` memory note). QSA's raw-key ring
+    (``CircularBufferSpec``, ring capacity 8 at spec=3,
+    indexer_compress_ratio=4) is NOT prefix-cacheable
+    (``CircularBufferSpec.prefix_cacheable`` is ``False`` -- it holds only
+    the still-uncommitted rows of one in-flight compression group), so it
+    is excluded from ``hashing_sizes``. Only the QSA compressed-key group
+    (``MLAAttentionSpec``) and the mamba/GDN state group (``MambaSpec``,
+    ``mamba_cache_mode="align"``) are prefix-cacheable, and both already
+    sit at ``block_size=832`` -- their GCD is trivially 832, which is
+    exactly why prefix caching today matches only at full-832-token
+    granularity (an agent turn landing mid-block re-prefills up to 831
+    tokens).
+    """
+    block_size = 832
+    compressed_key_spec = MLAAttentionSpec(
+        block_size=block_size,
+        num_kv_heads=1,
+        head_size=576,
+        dtype=torch.bfloat16,
+    )
+    mamba_spec = MambaSpec(
+        block_size=block_size,
+        shapes=((16384,),),
+        dtypes=(torch.bfloat16,),
+        mamba_cache_mode="align",
+    )
+    raw_key_ring_spec = CircularBufferSpec(
+        block_size=8,
+        num_kv_heads=1,
+        head_size=128,
+        dtype=torch.bfloat16,
+    )
+    assert compressed_key_spec.prefix_cacheable is True
+    assert mamba_spec.prefix_cacheable is True
+    assert raw_key_ring_spec.prefix_cacheable is False
+
+    groups = [
+        KVCacheGroupSpec(["model.layers.0.qsa_compressed"], compressed_key_spec),
+        KVCacheGroupSpec(["model.layers.0.mamba"], mamba_spec),
+        KVCacheGroupSpec(["model.layers.0.qsa_ring"], raw_key_ring_spec),
+    ]
+    kv_cache_config = KVCacheConfig(num_blocks=1, kv_cache_tensors=[], kv_cache_groups=groups)
+
+    def _vllm_config(prefix_match_unit):
+        return SimpleNamespace(
+            cache_config=SimpleNamespace(
+                block_size=block_size,
+                enable_prefix_caching=True,
+                prefix_match_unit=prefix_match_unit,
+            ),
+            parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+            kv_transfer_config=None,
+        )
+
+    # Today's behavior (no override): hash_block_size collapses to the
+    # full attention block -- this is the reported defect.
+    assert kv_cache_utils.resolve_kv_cache_block_sizes(
+        kv_cache_config, _vllm_config(None)
+    ) == (832, 832)
+
+    # Legal override: divides 832 (= 2**6 * 13) and is a multiple of
+    # indexer_compress_ratio=4 (checked separately by the CSA+linear
+    # group-building path, kv_cache_utils.py ~line 1839). Every divisor of
+    # 832 that is also a multiple of 4: 4, 8, 16, 32, 52, 64, 104, 208, 416.
+    for legal in (4, 8, 16, 32, 52, 64, 104, 208, 416):
+        assert kv_cache_utils.resolve_kv_cache_block_sizes(
+            kv_cache_config, _vllm_config(legal)
+        ) == (832, legal)
+
+    # Illegal: does not divide 832 at all.
+    with pytest.raises(ValueError, match="prefix_match_unit"):
+        kv_cache_utils.resolve_kv_cache_block_sizes(kv_cache_config, _vllm_config(100))
+
+    # Illegal in practice: divides 832 but is not a multiple of
+    # indexer_compress_ratio=4 (26 * 32 == 832). resolve_kv_cache_block_sizes
+    # itself does not know about the compression ratio -- only the
+    # CSA+linear group-building path enforces that constraint -- so this
+    # passes here but would be rejected at model-load time.
+    assert kv_cache_utils.resolve_kv_cache_block_sizes(
+        kv_cache_config, _vllm_config(26)
+    ) == (832, 26)
+
