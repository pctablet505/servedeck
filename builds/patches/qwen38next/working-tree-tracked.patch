     }
 
 
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "include_reasoning", [True, False], ids=["with_reasoning", "no_reasoning"]
+)
+async def test_non_streaming_reasoning_field_and_usage_counts(include_reasoning):
+    """T1 (2026-09-09 investigation): does the non-streaming response
+    actually drop reasoning content, or is it a client field-name
+    mismatch?
+
+    Exercises the real ``chat_completion_full_generator()`` path
+    (serving.py ``chat_completion_full_generator``, the
+    ``parser.parse()`` / ``include_reasoning`` / ``count_reasoning_tokens``
+    block): ``reasoning`` comes from ``parser.parse()`` and is nulled out
+    ONLY when ``request.include_reasoning`` is ``False``, while
+    ``parser.count_reasoning_tokens()`` is always added to usage
+    regardless of that flag. This reproduces the exact reported symptom
+    -- a ``None`` message field alongside a nonzero
+    ``usage.completion_tokens_details.reasoning_tokens`` -- and shows it
+    is gated by ``include_reasoning`` (default ``True``), not an
+    unconditional drop. It also locks in that the field to read is
+    ``message.reasoning``, not ``message.reasoning_content``: this
+    build's ``ChatMessage`` has no ``reasoning_content`` field at all
+    (renamed upstream -- see ``chat_completion/protocol.py``'s
+    ``_normalize_messages_before`` docstring, and
+    ``vllm-project/vllm@main`` which matches this file byte-for-byte).
+    """
+    serving = _build_minimal_metrics_serving_chat(enable_per_request_metrics=False)
+    serving._include_reasoning_tokens_details = True
+    serving.model_config = None
+
+    parser = MagicMock()
+    parser.parse.return_value = ("careful reasoning", "42", None)
+    parser.count_reasoning_tokens.return_value = 5
+
+    output = _make_metrics_request_output(metrics=None, token_ids=(10, 11, 12))
+    output.outputs[0].text = "<think>careful reasoning</think>42"
+
+    request = ChatCompletionRequest(
+        model="test-model",
+        messages=[{"role": "user", "content": "Test prompt"}],
+        max_tokens=10,
+        include_reasoning=include_reasoning,
+    )
+
+    response = await serving.chat_completion_full_generator(
+        request,
+        _single_request_output(output),
+        "chatcmpl-test-id",
+        "test-model",
+        conversation=[{"role": "user", "content": "Test"}],
+        tokenizer=MagicMock(),
+        request_metadata=RequestResponseMetadata(request_id="chatcmpl-test-id"),
+        parser=parser,
+    )
+
+    assert isinstance(response, ChatCompletionResponse)
+    message = response.choices[0].message
+    dumped = message.model_dump()
+    assert "reasoning_content" not in dumped, (
+        "ChatMessage has no reasoning_content field in this vLLM version; "
+        "clients must read `reasoning`."
+    )
+
+    # usage.reasoning_tokens is unconditional: parser.count_reasoning_tokens()
+    # is called regardless of include_reasoning (serving.py).
+    assert response.usage.completion_tokens_details.reasoning_tokens == 5
+
+    if include_reasoning:
+        assert message.reasoning == "careful reasoning"
+    else:
+        assert message.reasoning is None
+
+
