         env_vars.update({v: "1" for v in current_platform.ray_noset_device_env_vars})
+        update_runtime_env_for_worker_import(runtime_env)
         if self.parallel_config.ray_workers_use_nsight:
             runtime_env["nsight"] = {
                 "t": "cuda,cudnn,cublas",
