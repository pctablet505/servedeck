# profiles/flashnext.env -- Qwen3.8-Flash-Next ABLITERATED (NVFP4), the model
# actually serving on :8001 today. Replaces
# ~/Projects/vllm-qwen38next/serve-abliterated.sh -> serve.sh (the pair, not
# either alone: serve-abliterated.sh only sets env, lowers vm.swappiness and
# execs serve.sh).
#
# HOW THIS FITS ON ONE CARD: the checkpoint is ~130 GB but ~51 GB of it is the
# n-gram (PLE) embedding table, which VLLM_PLE_CPU_OFFLOAD keeps in host RAM
# and prefetches asynchronously, leaving ~76 GB of weights in VRAM plus KV.
#
# SAFETY: this checkpoint has had its refusal direction abliterated. It will
# comply with harmful/illegal requests. Research use only.
P_FAMILY=flashnext
P_ROOT=/home/pctablet505/Projects/vllm-qwen38next
P_VENV="$P_ROOT/.venv-next"

# The base RadixArk checkpoint was deleted on 2026-08-29 (archived to Ventoy);
# defaulting to it would make a bare run silently re-download 126 GB.
P_MODEL="mazinb/Qwen3.8-Flash-Next-Uncensored-NVFP4"
# Stays "qwen38-flash-next" so ~/.codex config and every client keep working.
P_SERVED_NAME="qwen38-flash-next"
P_PORT=8001
P_MAX_LEN=262144
P_GPU_UTIL=0.95
P_MAX_SEQS=1
P_MAX_BATCHED=8192
P_KV_DTYPE=auto

# P_MM_LIMIT: --limit-mm-per-prompt, i.e. whether this server can see images.
# IMAGES ON. The owner's requirement is "we want images and multimodal to be
# enabled"; the value matches the default vllm-qwen38next/serve.sh carries
# since 2026-09-10, and $MM_LIMIT_JSON overrides it exactly as it does there
# (mm_limit is listed in P_ENV_KNOBS below). Measured cost of image=2 on this
# box: weights +0.81 GiB (the 0.84 GiB vision tower) plus 0.49 GiB of
# multimodal profiling peak and encoder cache, i.e. KV 7.98 -> 7.63 GiB and
# 290,925 -> 278,479 tokens at GPU_MEM_UTIL 0.96 -- which still holds a full
# 262,144-token request (1.06x). Set MM_LIMIT_JSON='{"image":0,"video":0}' to
# trade images back for KV headroom on a long-context run.
P_MM_LIMIT='{"image":2,"video":0}'

P_PYTORCH_ALLOC_CONF="expandable_segments:True"
P_TORCH_CUDA_ARCH_LIST=12.0f
P_FLASHINFER_SAMPLER=0

# PLE offload. The FP8-vs-BF16 n-gram table flag is DETECTED from the cached
# snapshot by bin/serve-model.sh, never set here: RadixArk/Inferact ship the
# table FP8, primitive-ai/mazinb ship it BF16, and getting it wrong kills the
# load either way. BF16 tables are ~95 GB and blow past the 600 s offload
# default, hence the raised timeout (mazinb README: 1800).
P_PLE_OFFLOAD=1
P_PLE_TIMEOUT_BF16=1800
# Fully cached; go offline so a DNS hiccup cannot stall boot.
P_HF_HUB_OFFLINE=1
# The PLE worker's peak RSS (~103 G) collides with the main worker's weight
# load. swappiness=60 evicts the cold-once-written PLE table to swap instead of
# dropping clean file pages, and swap faults on PLE lookups cost ~35% of decode.
P_SWAPPINESS=10
P_HF_TOKEN_FROM_BASHRC=1
# torch transfers the CUDA IPC handle with pidfd_getfd(), which needs
# PTRACE_MODE_ATTACH between siblings. Relaxed for the handoff, re-hardened the
# moment the server answers. This is why starting Flash-Next asks for sudo --
# and why servedeck.toml marks this backend needs_tty.
P_NEEDS_PTRACE=1

# MTP-3, measured healthy on this checkpoint: acceptance length 3.11, rate
# 0.833. k=4 is a wash (the extra draft step costs ~8.5% of pass rate) and
# k>=5 trips "QSA ring capacity must divide the attention block size".
P_SPEC=1
P_SPEC_METHOD=mtp
P_SPEC_TOKENS=3
# Autotune deliberately LEFT ON: +3.4% forward-pass rate measured 2026-08-31.
P_AUTOTUNE=1

P_TOOL_PARSER=qwen3_coder
P_REASONING_PARSER=qwen3
P_EXTRA_ARGS_POS=end     # serve.sh appends $EXTRA_ARGS last, unlike serve-opt.sh

# serve-abliterated.sh EXPORTS these after resolving them, so the vLLM child
# gets them in its environment; the bare serve.sh (profiles/flashnext-base.env)
# and serve-tuned.sh do not, which is why this key is set here and nowhere
# else. Nothing downstream reads them -- vLLM reads VLLM_*/HF_*/CUDA_*/
# PYTORCH_*/TORCH_* -- but the contract is an identical environment, not an
# equivalent one.
P_EXPORT_LAUNCH_VARS="MODEL SERVED_NAME PORT MAX_LEN MAX_SEQS GPU_UTIL KV_DTYPE"

# serve.sh has NO port or duplicate-launch guard. Left off so the cutover is a
# pure no-op; turn them on deliberately, in a separate change, with a test.
P_GUARD_PORT=0
P_GUARD_DUP_PATTERN=
P_LOG_MODE=inherit       # `llm` cmd_start redirects into logs/server.log
P_EXEC=0

# P_ENV_KNOBS: the optional environment knobs the script this profile
# replaces actually honoured. Anything not listed is ignored, so the
# unified launcher cannot accept a knob the old path did not.
P_ENV_KNOBS="max_batched mm_limit"
