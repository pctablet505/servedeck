# profiles/glm53-legacy.env -- the PRE-TUNING GLM-5.3 configuration.
# Replaces ~/Projects/vllm-glm53/serve.sh, which serve-opt.sh superseded on
# 2026-09-01. Kept only so the old configuration can still be reproduced for a
# bisection; it boots the SLOW shape (no hot-expert pinning, no grouped prefill
# staging, no KV cap, autotune off, speculation off) and should not be the
# thing `llm start` launches.
P_FAMILY=glm53
P_ROOT=/home/pctablet505/Projects/vllm-glm53
P_VENV="$P_ROOT/.venv-glm53"
P_RUNDIR="$P_ROOT/run"

# A LOCAL PATH, not a hub id -- serve.sh defaulted to $HOME/Models/... while
# serve-opt.sh defaults to the hub id. Preserved as-is.
P_MODEL="$HOME/Models/GLM-5.3-Flash-ABLITERATED-NVFP4"
P_SERVED_NAME="glm53-flash"
P_PORT=8002
# 524288, which is what serve.sh's ARGUMENT resolves to. Its own banner line
# printed 262144 -- the two disagreed, and the argument is what ran. See the
# handover notes; this profile keeps the behaviour, not the banner.
P_MAX_LEN=524288
P_GPU_UTIL=0.93
P_MAX_SEQS=1
P_MAX_BATCHED=8192
P_KV_DTYPE=auto
P_LOAD_FORMAT=auto

# P_MM_LIMIT: --limit-mm-per-prompt. IMAGES OFF, because vllm-glm53/serve.sh hardcodes
# '{"image":0,"video":0}' and the contract of this launcher is byte-identical
# argv. This checkpoint DOES have a vision tower (config.json carries a
# vision_config), so images are a real option here -- but turning them on costs
# VRAM on the one profile whose usable context ceiling is already set by FREE
# VRAM rather than by --max-model-len (see P_HOT_SLOTS above), so it needs a
# measurement on the card, not a config edit. mm_limit is deliberately NOT in
# P_ENV_KNOBS: vllm-glm53/serve.sh ignores $MM_LIMIT_JSON, so this launcher must too.
P_MM_LIMIT='{"image":0,"video":0}'

P_CPU_OFFLOAD_GB=112
P_EXPORT_CPU_OFFLOAD=0   # serve.sh kept it shell-local; serve-opt.sh exports it
P_HOT_SLOTS=
P_HOT_PROFILE=
P_PREFILL_GROUPS=
P_BREAKABLE_CUDAGRAPH=
P_DEEP_GEMM=0
P_WEIGHT_OFFLOAD_DISABLE_PIN=1
P_PYTORCH_ALLOC_CONF="expandable_segments:True,pinned_use_cuda_host_register:True,pinned_num_register_threads:8"
P_TORCH_CUDA_ARCH_LIST=12.0f
P_FLASHINFER_SAMPLER=0
P_MOE_BACKEND=marlin

P_SPEC=0                 # serve.sh defaulted speculation OFF
P_SPEC_METHOD=mtp
P_SPEC_TOKENS=2
P_AUTOTUNE=0             # -> --no-enable-flashinfer-autotune, hardcoded there
P_KV_BYTES_PER_TOKEN=    # no --kv-cache-memory-bytes at all

P_TOOL_PARSER=glm47
P_REASONING_PARSER=glm47
P_EXTRA_ARGS_POS=none    # serve.sh never consumed EXTRA_ARGS

P_NEEDS_PTRACE=0
P_GUARD_CWD_SHADOW=1
P_GUARD_HOST_RAM=1
P_RAM_OVERHEAD_GIB=45    # serve.sh used +45 while its message said "+15"
P_GUARD_PORT=1
P_GUARD_DUP_PATTERN="vllm-glm53/.venv-glm53/bin/vllm serve"
P_LOG_MODE=inherit
P_EXEC=0

# P_ENV_KNOBS: the optional environment knobs the script this profile
# replaces actually honoured. Anything not listed is ignored, so the
# unified launcher cannot accept a knob the old path did not.
P_ENV_KNOBS="max_batched"
