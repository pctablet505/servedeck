# profiles/glm53.env -- GLM-5.3-Flash (NVFP4) on one RTX PRO 6000.
# Replaces ~/Projects/vllm-glm53/serve-opt.sh. Every value below is the value
# that script resolves to today; tests/test_serve_model_golden.sh proves it.
#
# HOW THIS FITS ON ONE CARD: the checkpoint is 181.3 GiB but 163.3 GiB of it
# (90%) is routed MoE expert weights. --cpu-offload-params experts keeps those
# in pinned host RAM and the GPU reads them over PCIe via UVA; everything else
# (attention, embeddings, shared expert, norms) is 18.0 GiB and stays resident.
# Top-8-of-288 routing is why the *uva* backend is right and *prefetch* is not.
P_FAMILY=glm53
P_ROOT=/home/pctablet505/Projects/vllm-glm53
P_VENV="$P_ROOT/.venv-glm53"
P_RUNDIR="$P_ROOT/run"

P_MODEL="dealignai/GLM-5.3-Flash-ABLITERATED-NVFP4"
P_SERVED_NAME="glm53-flash"
P_PORT=8002
P_MAX_LEN=327680
P_GPU_UTIL=0.95
P_MAX_SEQS=1
P_MAX_BATCHED=8192          # 4096 crashes the engine outright; that lever is closed
P_KV_DTYPE=auto
P_LOAD_FORMAT=auto

# P_MM_LIMIT: --limit-mm-per-prompt. IMAGES OFF, because serve-opt.sh hardcodes
# '{"image":0,"video":0}' and the contract of this launcher is byte-identical
# argv. This checkpoint DOES have a vision tower (config.json carries a
# vision_config), so images are a real option here -- but turning them on costs
# VRAM on the one profile whose usable context ceiling is already set by FREE
# VRAM rather than by --max-model-len (see P_HOT_SLOTS above), so it needs a
# measurement on the card, not a config edit. mm_limit is deliberately NOT in
# P_ENV_KNOBS: serve-opt.sh ignores $MM_LIMIT_JSON, so this launcher must too.
P_MM_LIMIT='{"image":0,"video":0}'

# --- the measured-best configuration (16.76 tok/s, 2026-08-31) --------------
# These are a MATCHED SET, not independent preferences:
#   offload 125 + 68 hot slots   16.76 tok/s   <- this profile
#   offload 105, no pinning      13.73 tok/s   (the old default)
#   offload 125, no pinning      11.34 tok/s   (more traffic, nothing to absorb)
# Offloading MORE is faster only because the VRAM it frees funds the hot-expert
# cache, and the hottest 36% of a layer's experts serve 75% of its fetches.
P_CPU_OFFLOAD_GB=125
P_EXPORT_CPU_OFFLOAD=1
# 54, down from 62, down from 68: long-prompt activation is allocated per
# request and scales with sequence length, so the usable context ceiling is set
# by FREE VRAM, not by --max-model-len. 60 slots / 3.4 GiB free kills a 180k
# prompt; 54 / 6.2 GiB prefills 304,800 tokens fine. 48 buys nothing.
P_HOT_SLOTS=54
# The profile is per-layer frequency counts tied to the offload above -- "layer
# N" means the Nth OFFLOADED layer, so a profile captured at another offload
# describes different layers. Regenerate with VLLM_MOE_SKEW_PERLAYER at the
# SAME offload.
P_HOT_PROFILE="$P_ROOT/hot-profile-125.json"
# Grouped prefill staging: 614 -> 1762 tok/s prefill, 10k TTFT 16.8 -> 5.8 s.
P_PREFILL_GROUPS=1
# vLLM auto-enables "breakable" CUDA graphs for this hybrid model; under that
# mode every build on 2026-09-02 died of an Xid 31 MMU fault after 2-24
# requests. OFF costs nothing measurable (15.8 tok/s either way).
P_BREAKABLE_CUDAGRAPH=0
# DeepGEMM's paged-MQA attention asserts arch_major == 10 (SM100); this is SM120.
P_DEEP_GEMM=0
# Handing the offloader an ALREADY-pinned tensor makes PyTorch's caching host
# allocator round to power-of-two blocks: 19.0 GiB of weights took 33.8 GiB of
# RAM. Unpinned lets the C++ op pin exact-size -- 1.94x -> 1.13x.
P_WEIGHT_OFFLOAD_DISABLE_PIN=1
P_PYTORCH_ALLOC_CONF="expandable_segments:True,pinned_use_cuda_host_register:True,pinned_num_register_threads:8"
P_TORCH_CUDA_ARCH_LIST=12.0f
P_FLASHINFER_SAMPLER=0

# MANDATORY on SM120. Both CUTLASS-family NVFP4 MoE kernels (flashinfer_cutlass
# -- what "auto" picks -- and vLLM's own cutlass) accept the work and return
# GARBAGE: the model loads, serves, and emits one token forever with no error.
# marlin is the only backend both accepted and correct (swept all five,
# 2026-08-29; vllm-glm53/FINDINGS.md bug 7).
P_MOE_BACKEND=marlin

# MTP draft head. Decode is PCIe-bound on expert fetches and verifying several
# tokens per forward reuses one fetch, so speculation converts saved bandwidth
# straight into tokens/s. 2, not 1 or 3: SPEC_TOKENS=1 dies with "illegal
# memory access" partway through a longer generation.
P_SPEC=1
P_SPEC_METHOD=mtp
P_SPEC_TOKENS=2

# FlashInfer autotune left at vLLM's -O2 default (+3.4% forward-pass rate).
P_AUTOTUNE=1
# KV cache capped from the context rather than sized from LEFTOVER budget, so
# moving Coldstart's context slider can never leave KV sized for the old
# context. ~15.0-15.7 KiB/token measured; 17200 adds ~10% headroom.
P_KV_BYTES_PER_TOKEN=17200

P_TOOL_PARSER=glm47
P_REASONING_PARSER=glm47
# serve-opt.sh splices $EXTRA_ARGS between --kernel-config and --load-format.
P_EXTRA_ARGS_POS=mid

# No sudo anywhere in this profile: UVA offload is in-process pinned memory,
# with none of the CUDA-IPC/pidfd_getfd handoff that forces ptrace_scope=0 for
# Flash-Next.
P_NEEDS_PTRACE=0
P_GUARD_CWD_SHADOW=1
P_GUARD_HOST_RAM=1
P_RAM_OVERHEAD_GIB=30   # steady state is offload + ~16 GiB; 30 keeps a cushion
P_GUARD_PORT=1
P_GUARD_DUP_PATTERN="vllm-glm53/.venv-glm53/bin/vllm serve"
P_LOG_MODE=inherit      # `llm` cmd_start owns the redirect and the rotation
P_EXEC=0

# P_ENV_KNOBS: the optional environment knobs the script this profile
# replaces actually honoured. Anything not listed is ignored, so the
# unified launcher cannot accept a knob the old path did not.
P_ENV_KNOBS="autotune enforce_eager block_size spec_method spec_extra max_batched"
