# profiles/flashnext-tuned.env -- the A/B rig from
# ~/Projects/vllm-qwen38next/serve-tuned.sh (see that tree's bench.py).
# It is NOT a faster flashnext: MTP depth 5 was the hypothesis being tested
# (conditional acceptance ~0.735/position predicted 2.67 -> ~3.18
# tokens-per-forward-pass) and the follow-up measurement on 2026-08-31 settled
# on depth 3, which is what profiles/flashnext.env ships. Keep this profile for
# re-running that comparison, not for serving.
#
# Three further differences from flashnext.env, all inherited from the script:
#   * $FI_SAMPLER may override VLLM_USE_FLASHINFER_SAMPLER (nothing else lets it)
#   * --max-num-batched-tokens is HARDCODED 8192, ignoring $MAX_BATCHED
#   * $EXTRA_ARGS is not consumed at all
P_FAMILY=flashnext
P_ROOT=/home/pctablet505/Projects/vllm-qwen38next
P_VENV="$P_ROOT/.venv-next"

P_MODEL="mazinb/Qwen3.8-Flash-Next-Uncensored-NVFP4"
P_SERVED_NAME="qwen38-flash-next"
P_PORT=8001
P_MAX_LEN=262144
P_GPU_UTIL=0.95
P_MAX_SEQS=1
P_MAX_BATCHED=8192
P_KV_DTYPE=auto

# P_MM_LIMIT: --limit-mm-per-prompt, i.e. whether this server can see images.
# IMAGES ON. The owner's requirement is "we want images and multimodal to be
# enabled"; the value matches the default vllm-qwen38next/serve-tuned.sh carries
# since 2026-09-10, and $MM_LIMIT_JSON overrides it exactly as it does there
# (mm_limit is listed in P_ENV_KNOBS below). Measured cost of image=2 on this
# box: weights +0.81 GiB (the 0.84 GiB vision tower) plus 0.49 GiB of
# multimodal profiling peak and encoder cache, i.e. KV 7.98 -> 7.63 GiB and
# 290,925 -> 278,479 tokens at GPU_MEM_UTIL 0.96 -- which still holds a full
# 262,144-token request (1.06x). Set MM_LIMIT_JSON='{"image":0,"video":0}' to
# trade images back for KV headroom on a long-context run.
P_MM_LIMIT='{"image":2,"video":0}'

P_PYTORCH_ALLOC_CONF="expandable_segments:True"
P_TORCH_CUDA_ARCH_LIST=12.0f
P_FLASHINFER_SAMPLER=0

P_PLE_OFFLOAD=1
P_PLE_TIMEOUT_BF16=1800
P_HF_HUB_OFFLINE=
P_SWAPPINESS=
P_HF_TOKEN_FROM_BASHRC=1
P_NEEDS_PTRACE=1

P_SPEC=1
P_SPEC_METHOD=mtp
P_SPEC_TOKENS=5
P_AUTOTUNE=1

P_TOOL_PARSER=qwen3_coder
P_REASONING_PARSER=qwen3
P_EXTRA_ARGS_POS=none

P_GUARD_PORT=0
P_GUARD_DUP_PATTERN=
P_LOG_MODE=inherit
P_EXEC=0

# P_ENV_KNOBS: the optional environment knobs the script this profile
# replaces actually honoured. Anything not listed is ignored, so the
# unified launcher cannot accept a knob the old path did not.
P_ENV_KNOBS="fi_sampler autotune mm_limit"
